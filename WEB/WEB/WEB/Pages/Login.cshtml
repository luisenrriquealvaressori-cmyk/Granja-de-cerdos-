@page
@model WEB.Pages.LoginModel
@{
    ViewData["Title"] = "Acceso al Sistema - AgroPig Intelligence";
    Layout = null; // Pantalla completa de login independiente
}
<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Acceso seguro a AgroPig Intelligence Suite: gestión integral de granjas porcinas." />
    <meta name="robots" content="noindex" />
    <title>Iniciar Sesión • AgroPig Intelligence Suite</title>

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#566342",
                        "primary-dark": "#33401f",
                        "primary-container": "#a3b18a",
                        "primary-fixed": "#dae8be",
                        "secondary": "#45664b",
                        "surface": "#f9f9fb",
                        "on-surface": "#1a1c1e",
                        "on-surface-variant": "#45483f",
                        "outline": "#76786e",
                        "outline-variant": "#c6c8bb",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6"
                    },
                    fontFamily: {
                        "headline": ["Plus Jakarta Sans", "sans-serif"],
                        "body": ["Inter", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20; font-size: 20px; display: inline-block; vertical-align: middle; line-height: 1; }
        .hero-bg {
            background:
                radial-gradient(1200px 600px at 10% -10%, rgba(218,232,190,.35), transparent 60%),
                radial-gradient(900px 500px at 110% 110%, rgba(163,177,138,.35), transparent 60%),
                linear-gradient(145deg, #2b3719 0%, #3f4f2c 45%, #566342 100%);
        }
        .blob { position: absolute; border-radius: 9999px; filter: blur(60px); opacity: .45; animation: float 14s ease-in-out infinite; }
        .blob.b2 { animation-delay: -6s; animation-duration: 18s; }
        @@keyframes float { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(30px,-40px) scale(1.12); } }
        .grain { background-image: radial-gradient(rgba(255,255,255,.07) 1px, transparent 1px); background-size: 22px 22px; }
        .fade-up { animation: fadeUp .7s cubic-bezier(.2,.8,.2,1) both; }
        .fade-up.d1 { animation-delay: .08s; } .fade-up.d2 { animation-delay: .16s; } .fade-up.d3 { animation-delay: .24s; }
        @@keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
        .field:focus-within { box-shadow: 0 0 0 4px rgba(86,99,66,.14); border-color: #566342; }
        .shake { animation: shake .4s; }
        @@keyframes shake { 10%,90% { transform: translateX(-1px);} 20%,80% { transform: translateX(2px);} 30%,50%,70% { transform: translateX(-4px);} 40%,60% { transform: translateX(4px);} }
        @@media (prefers-reduced-motion: reduce) { .blob, .fade-up, .shake { animation: none !important; } }
    </style>
</head>
<body class="min-h-full bg-surface text-on-surface antialiased font-body">
<main class="min-h-screen grid lg:grid-cols-[1.05fr_1fr]">

    <!-- Panel de marca -->
    <section class="hero-bg relative hidden lg:flex flex-col justify-between p-12 text-white overflow-hidden" aria-hidden="true">
        <div class="blob w-80 h-80 bg-primary-fixed -top-20 -left-16"></div>
        <div class="blob b2 w-96 h-96 bg-primary-container bottom-0 right-0"></div>
        <div class="grain absolute inset-0"></div>

        <div class="relative flex items-center gap-3 fade-up">
            <div class="w-12 h-12 rounded-2xl bg-white/15 backdrop-blur border border-white/25 flex items-center justify-center shadow-lg">
                <span class="material-symbols-outlined text-[28px]" style="font-variation-settings:'FILL' 1;">pets</span>
            </div>
            <div>
                <p class="font-headline font-extrabold text-xl leading-none">AgroPig</p>
                <p class="text-[11px] tracking-[.22em] uppercase text-primary-fixed/90 mt-1">Intelligence Suite</p>
            </div>
        </div>

        <div class="relative max-w-lg">
            <h2 class="font-headline text-4xl xl:text-5xl font-extrabold leading-tight fade-up d1">
                Cada decisión de tu granja, <span class="text-primary-fixed">respaldada por datos.</span>
            </h2>
            <p class="mt-5 text-primary-fixed/90 text-base leading-relaxed fade-up d2">
                Inventario, sanidad, reproducción y presupuestos en un solo lugar, con trazabilidad completa y sincronización móvil para tu equipo de campo.
            </p>

            <div class="mt-10 grid grid-cols-3 gap-4 fade-up d3">
                <div class="rounded-2xl bg-white/10 border border-white/15 backdrop-blur p-4">
                    <span class="material-symbols-outlined text-primary-fixed">inventory_2</span>
                    <p class="mt-2 text-sm font-bold">Kardex</p>
                    <p class="text-[11px] text-primary-fixed/80">Control de insumos</p>
                </div>
                <div class="rounded-2xl bg-white/10 border border-white/15 backdrop-blur p-4">
                    <span class="material-symbols-outlined text-primary-fixed">vaccines</span>
                    <p class="mt-2 text-sm font-bold">Sanidad</p>
                    <p class="text-[11px] text-primary-fixed/80">Tratamientos y partos</p>
                </div>
                <div class="rounded-2xl bg-white/10 border border-white/15 backdrop-blur p-4">
                    <span class="material-symbols-outlined text-primary-fixed">monitoring</span>
                    <p class="mt-2 text-sm font-bold">Finanzas</p>
                    <p class="text-[11px] text-primary-fixed/80">Presupuestos por lote</p>
                </div>
            </div>
        </div>

        <p class="relative text-xs text-primary-fixed/70 flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px]">verified_user</span>
            Acceso protegido · Sesiones cifradas · Registro de auditoría
        </p>
    </section>

    <!-- Formulario -->
    <section class="flex items-center justify-center px-5 sm:px-10 py-12 bg-gradient-to-b from-surface to-[#eef1e6]">
        <div class="w-full max-w-md">

            <div class="lg:hidden text-center mb-8 fade-up">
                <div class="inline-flex w-14 h-14 rounded-2xl bg-primary text-white items-center justify-center shadow-lg mb-3">
                    <span class="material-symbols-outlined text-[30px]" style="font-variation-settings:'FILL' 1;">pets</span>
                </div>
                <p class="font-headline text-2xl font-extrabold text-primary">AgroPig Intelligence</p>
            </div>

            <div class="fade-up">
                <h1 class="font-headline text-3xl font-extrabold text-on-surface tracking-tight">Bienvenido de nuevo</h1>
                <p class="mt-2 text-sm text-on-surface-variant">Inicia sesión con tu cuenta corporativa para continuar.</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div role="status" class="mt-6 rounded-xl bg-emerald-50 border border-emerald-200 p-3.5 text-emerald-800 text-sm font-medium flex items-center gap-2.5 fade-up">
                    <span class="material-symbols-outlined text-emerald-600">check_circle</span>
                    <span>@Model.SuccessMessage</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div role="alert" class="mt-6 rounded-xl bg-error-container/70 border border-error/40 p-3.5 text-error text-sm font-medium flex items-start gap-2.5 shake">
                    <span class="material-symbols-outlined text-error mt-0.5">error</span>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form method="post" class="mt-7 space-y-5 fade-up d1" id="loginForm" autocomplete="on" novalidate>
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                <div>
                    <label for="email" class="block text-sm font-semibold text-on-surface mb-1.5">Nombre de usuario</label>
                    <div class="field relative flex items-center rounded-xl border border-outline-variant bg-white transition-all">
                        <span class="material-symbols-outlined pl-3.5 text-outline">person</span>
                        <input id="email" name="Email" type="text" value="@Model.Email" required autofocus autocomplete="username"
                               class="w-full border-0 bg-transparent focus:ring-0 py-3 pl-2.5 pr-3 text-sm text-on-surface placeholder:text-outline" placeholder="admin, vet u operario">
                    </div>
                </div>

                <div>
                    <label for="password" class="block text-sm font-semibold text-on-surface mb-1.5">Contraseña</label>
                    <div class="field relative flex items-center rounded-xl border border-outline-variant bg-white transition-all">
                        <span class="material-symbols-outlined pl-3.5 text-outline">lock</span>
                        <input id="password" name="Password" type="password" required autocomplete="current-password"
                               class="w-full border-0 bg-transparent focus:ring-0 py-3 pl-2.5 pr-11 text-sm text-on-surface placeholder:text-outline" placeholder="••••••••">
                        <button type="button" id="togglePwd" aria-label="Mostrar u ocultar contraseña"
                                class="absolute right-2 p-2 rounded-lg text-outline hover:text-primary hover:bg-surface transition">
                            <span id="pwdIcon" class="material-symbols-outlined text-[20px]">visibility</span>
                        </button>
                    </div>
                    <p id="capsWarn" class="hidden mt-1.5 text-xs font-medium text-amber-700 items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">keyboard_capslock</span> Bloq Mayús activado
                    </p>
                </div>

                <label class="flex items-center gap-2.5 cursor-pointer select-none">
                    <input id="Recordar" name="Recordar" type="checkbox" value="true" class="h-4 w-4 rounded border-outline-variant text-primary focus:ring-primary">
                    <span class="text-sm text-on-surface-variant">Mantener sesión en este equipo (7 días)</span>
                </label>

                <button type="submit" id="submitBtn"
                        class="group w-full flex items-center justify-center gap-2 rounded-xl bg-primary text-white py-3.5 text-sm font-bold shadow-lg shadow-primary/25 hover:bg-primary-dark hover:shadow-xl active:scale-[.99] transition-all disabled:opacity-70">
                    <span id="btnText">Ingresar al sistema</span>
                    <span id="btnIcon" class="material-symbols-outlined text-[20px] transition-transform group-hover:translate-x-1">arrow_forward</span>
                    <svg id="btnSpin" class="hidden animate-spin h-5 w-5" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"/><path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
                </button>
            </form>

            <div class="mt-8 rounded-xl border border-outline-variant/70 bg-white/70 p-3.5 flex items-start gap-3 text-xs text-on-surface-variant fade-up d2">
                <span class="material-symbols-outlined text-primary">shield_lock</span>
                <p>Tras <strong>5 intentos fallidos</strong> la cuenta se bloquea 10 minutos. Si olvidaste tu contraseña, solicita un restablecimiento al administrador.</p>
            </div>

            <!-- Selector Rápido de Usuarios Oficiales -->
            <div class="mt-5 p-3.5 rounded-xl bg-surface-container-low border border-outline-variant/80 flex flex-col gap-2 fade-up d2">
                <div class="flex items-center justify-between text-[11px] font-bold">
                    <span class="text-outline uppercase tracking-wider">Perfiles Oficiales Disponibles:</span>
                    <span class="text-primary">Clave: Prueba#2026</span>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <button type="button" onclick="autoLogin('admin', 'Prueba#2026')" class="p-2 rounded-lg bg-white hover:bg-emerald-50 border border-emerald-200 text-left transition-all group">
                        <div class="font-bold text-xs text-on-surface group-hover:text-emerald-800">admin</div>
                        <div class="text-[10px] text-emerald-800 font-semibold">Admin General</div>
                    </button>
                    <button type="button" onclick="autoLogin('luis', 'Prueba#2026')" class="p-2 rounded-lg bg-white hover:bg-emerald-50 border border-emerald-200 text-left transition-all group">
                        <div class="font-bold text-xs text-on-surface group-hover:text-emerald-800">luis</div>
                        <div class="text-[10px] text-emerald-800 font-semibold">Luis (Admin)</div>
                    </button>
                    <button type="button" onclick="autoLogin('junior', 'Prueba#2026')" class="p-2 rounded-lg bg-white hover:bg-teal-50 border border-teal-200 text-left transition-all group">
                        <div class="font-bold text-xs text-on-surface group-hover:text-teal-800">junior</div>
                        <div class="text-[10px] text-teal-800 font-semibold">Junior MVZ (Vet)</div>
                    </button>
                    <button type="button" onclick="autoLogin('jorgejr', 'Prueba#2026')" class="p-2 rounded-lg bg-white hover:bg-amber-50 border border-amber-200 text-left transition-all group">
                        <div class="font-bold text-xs text-on-surface group-hover:text-amber-800">jorgejr</div>
                        <div class="text-[10px] text-amber-800 font-semibold">Jorge Jr. (Operario)</div>
                    </button>
                </div>
            </div>

            <p class="mt-8 text-center text-xs text-outline">AgroPig Intelligence Suite · Sincronización móvil offline</p>
        </div>
    </section>
</main>

<script>
    function autoLogin(u, p) {
        document.getElementById('email').value = u;
        document.getElementById('password').value = p;
        document.getElementById('loginForm').submit();
    }

    (function () {
        const pwd = document.getElementById('password');
        const icon = document.getElementById('pwdIcon');
        document.getElementById('togglePwd').addEventListener('click', function () {
            const show = pwd.type === 'password';
            pwd.type = show ? 'text' : 'password';
            icon.textContent = show ? 'visibility_off' : 'visibility';
        });
        pwd.addEventListener('keyup', function (e) {
            const w = document.getElementById('capsWarn');
            const on = e.getModifierState && e.getModifierState('CapsLock');
            w.classList.toggle('hidden', !on);
            w.classList.toggle('flex', !!on);
        });
        document.getElementById('loginForm').addEventListener('submit', function () {
            const b = document.getElementById('submitBtn');
            b.disabled = true;
            document.getElementById('btnText').textContent = 'Verificando…';
            document.getElementById('btnIcon').classList.add('hidden');
            document.getElementById('btnSpin').classList.remove('hidden');
        });
    })();
</script>
</body>
</html>
