@page
@model IndexModel
@inject WEB.Services.UserRoleService RoleService
@{
    ViewData["Title"] = "Consola Lógica & Costes";
    var invCulture = System.Globalization.CultureInfo.InvariantCulture;
    var centrosJson = System.Text.Json.JsonSerializer.Serialize(Model.Data.BarrasCentroCosto);
    var flujoJson = System.Text.Json.JsonSerializer.Serialize(Model.Data.BarrasMensuales);
    var pref = Model.PreferenciasUi ?? new WEB.Services.PreferenciasUiUsuarioDto();
    var modulos = pref.ModulosVisibles ?? new List<string>();
    bool HasMod(string key) => modulos.Count == 0 || modulos.Contains(key);
    var monedaPref = RoleService.EsAdmin && string.Equals(pref.MonedaPreferida, "USD", StringComparison.OrdinalIgnoreCase) ? "USD" : (RoleService.EsAdmin ? pref.MonedaPreferida : "NIO");
    var compactGap = pref.ModoCompacto ? "gap-3" : "gap-5";
    var compactPad = pref.ModoCompacto ? "p-3 sm:p-4" : "p-4 sm:p-6";
}

<div class="@compactPad max-w-[1440px] mx-auto flex flex-col @compactGap">
    <!-- Encabezado y Controles -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs">
        <div>
            <div class="flex items-center gap-2">
                <span class="text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-primary-fixed text-on-primary-fixed">
                    Granja Porcina San José
                </span>
                <span class="text-[11px] text-on-surface-variant font-semibold">Motor en vivo PostgreSQL</span>
                @if (!string.IsNullOrWhiteSpace(pref.GalponPredeterminado))
                {
                    <span class="text-[11px] font-bold px-2 py-0.5 rounded-md bg-surface-container-high text-on-surface">
                        Galpón: @pref.GalponPredeterminado
                    </span>
                }
            </div>
            <h1 class="font-headline text-xl sm:text-2xl font-extrabold text-on-surface mt-1">
                Consola de Lógica Zootécnica &amp; Costes
            </h1>
            <p class="text-xs text-on-surface-variant">
                Indicadores biológicos (ICA, GMD, ciclo 114d), sincronización móvil de campo y vista personalizable por rol.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <button type="button" onclick="abrirModalPersonalizarUi()" class="inline-flex items-center gap-1.5 bg-surface-container-low border border-outline-variant text-on-surface px-3 py-2 rounded-xl text-xs font-bold hover:bg-surface-container transition">
                <span class="material-symbols-outlined text-[16px]">tune</span>
                <span>Personalizar Vista</span>
            </button>
            @if (RoleService.EsAdmin)
            {
                <div class="inline-flex rounded-xl border border-outline-variant bg-surface-container-low p-1 text-xs font-bold" role="group" aria-label="Selector de moneda">
                    <button type="button" id="btn-moneda-usd" onclick="setMonedaConsola('USD')" class="px-3 py-1.5 rounded-lg bg-primary text-on-primary transition-all">USD ($)</button>
                    <button type="button" id="btn-moneda-nio" onclick="setMonedaConsola('NIO')" class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface transition-all">NIO (C$ 36.80)</button>
                </div>
                <a href="/Presupuestos" class="inline-flex items-center gap-1.5 bg-primary text-on-primary px-3.5 py-2 rounded-xl text-xs font-bold hover:bg-secondary transition shadow-xs">
                    <span class="material-symbols-outlined text-[16px]">monitoring</span>
                    <span>Centro de Costes</span>
                </a>
            }
            else if (RoleService.EsVeterinario)
            {
                <a href="/Reproduccion" class="inline-flex items-center gap-1.5 bg-teal-700 text-white px-3.5 py-2 rounded-xl text-xs font-bold hover:bg-teal-800 transition shadow-xs">
                    <span class="material-symbols-outlined text-[16px]">child_care</span>
                    <span>Ciclo 114d &amp; Partos</span>
                </a>
                <a href="/Cerdos" class="inline-flex items-center gap-1.5 bg-surface-container-lowest border border-teal-200 text-teal-900 px-3.5 py-2 rounded-xl text-xs font-bold hover:bg-teal-50 transition">
                    <span class="material-symbols-outlined text-[16px]">vaccines</span>
                    <span>Padrón &amp; Plan Vacunal</span>
                </a>
                <a href="/Calendario?Rol=Veterinario" class="inline-flex items-center gap-1.5 bg-surface-container-lowest border border-outline-variant text-on-surface px-3.5 py-2 rounded-xl text-xs font-bold hover:bg-surface-container-low transition">
                    <span class="material-symbols-outlined text-[16px]">calendar_month</span>
                    <span>Agenda Clínica</span>
                </a>
            }
            else
            {
                <a href="/Inventario#form-kardex" class="inline-flex items-center gap-1.5 bg-amber-800 text-white px-3.5 py-2 rounded-xl text-xs font-bold hover:bg-amber-900 transition shadow-xs">
                    <span class="material-symbols-outlined text-[16px]">inventory_2</span>
                    <span>Recepción Silos &amp; Bodega</span>
                </a>
                <a href="/Calendario" class="inline-flex items-center gap-1.5 bg-surface-container-lowest border border-outline-variant text-on-surface px-3.5 py-2 rounded-xl text-xs font-bold hover:bg-surface-container-low transition">
                    <span class="material-symbols-outlined text-[16px]">task_alt</span>
                    <span>Mis Tareas &amp; Labores</span>
                </a>
                <a href="/Cerdos" class="inline-flex items-center gap-1.5 bg-surface-container-lowest border border-outline-variant text-on-surface px-3.5 py-2 rounded-xl text-xs font-bold hover:bg-surface-container-low transition">
                    <span class="material-symbols-outlined text-[16px]">pets</span>
                    <span>Padrón de Cerdos</span>
                </a>
            }
        </div>
    </div>

    <!-- Barra rápida 1-clic de Galpón (filtrada en PostgreSQL según rol) -->
    @if (Model.GalponesSelector.Count > 0)
    {
        <div class="flex flex-wrap items-center gap-1.5 bg-surface-container-lowest border border-outline-variant rounded-2xl px-3.5 py-2.5 shadow-2xs text-xs">
            <span class="text-[10px] font-bold uppercase tracking-wider text-outline mr-1 flex items-center gap-1">
                <span class="material-symbols-outlined text-[14px]">filter_alt</span>
                <span>Nave / Galpón:</span>
            </span>
            <a href="/?GalponFiltro=ALL"
               class="px-2.5 py-1 rounded-full font-bold transition @(string.IsNullOrWhiteSpace(Model.GalponFiltroActivo) ? "bg-primary text-on-primary" : "bg-surface-container-low text-on-surface-variant hover:bg-surface-container")">
                Todas las Naves
            </a>
            @foreach (var g in Model.GalponesSelector)
            {
                var activoG = string.Equals(Model.GalponFiltroActivo, g.Codigo, StringComparison.OrdinalIgnoreCase);
                <a href="/?GalponFiltro=@Uri.EscapeDataString(g.Codigo)"
                   class="px-2.5 py-1 rounded-full font-semibold transition @(activoG ? "bg-primary text-on-primary font-bold" : "bg-surface-container-low text-on-surface-variant hover:bg-surface-container")">
                    @g.Nombre
                </a>
            }
        </div>
    }

    <!-- Fila de 4 KPIs Reales (adaptados por rol) -->
    @if (HasMod("METRICAS_VIVO"))
    {
        @if (RoleService.EsAdmin)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs flex flex-col justify-between">
                <div class="flex items-center justify-between text-xs font-bold text-on-surface-variant">
                    <span>COSTE / KG PRODUCIDO</span>
                    <span class="material-symbols-outlined text-primary">payments</span>
                </div>
                <div class="mt-2 font-headline text-2xl font-extrabold text-on-surface tabular-nums money-usd" data-usd="@Model.Data.CostoKgProducido.ToString(invCulture)">
                    $ @Model.Data.CostoKgProducido.ToString("N2")
                </div>
                <div class="mt-1 text-[11px] font-semibold @(Model.Data.VariacionCostoTarget <= 0 ? "text-emerald-700" : "text-amber-700")">
                    Desviación vs meta: @Model.Data.VariacionCostoTarget.ToString("+0.0;-0.0;0.0")% • Gasto total:
                    <span class="money-usd font-bold" data-usd="@Model.Data.TotalGastosOperativosUsd.ToString(invCulture)">$ @Model.Data.TotalGastosOperativosUsd.ToString("N2")</span>
                </div>
            </div>

            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs flex flex-col justify-between">
                <div class="flex items-center justify-between text-xs font-bold text-on-surface-variant">
                    <span>UTILIDAD &amp; MARGEN</span>
                    <span class="material-symbols-outlined text-emerald-700">trending_up</span>
                </div>
                <div class="mt-2 font-headline text-2xl font-extrabold @(Model.Data.UtilidadNetaUsd >= 0 ? "text-emerald-800" : "text-error") tabular-nums money-usd" data-usd="@Model.Data.UtilidadNetaUsd.ToString(invCulture)">
                    $ @Model.Data.UtilidadNetaUsd.ToString("N2")
                </div>
                <div class="mt-1 text-[11px] text-on-surface-variant font-semibold">
                    Margen operativo: <strong class="text-on-surface">@Model.Data.MargenOperativoPct.ToString("N1")%</strong> • Ingresos:
                    <span class="money-usd font-bold" data-usd="@Model.Data.TotalIngresosVentasUsd.ToString(invCulture)">$ @Model.Data.TotalIngresosVentasUsd.ToString("N2")</span>
                </div>
            </div>

            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs flex flex-col justify-between">
                <div class="flex items-center justify-between text-xs font-bold text-on-surface-variant">
                    <span>LOTES &amp; GANANCIA DIARIA</span>
                    <span class="material-symbols-outlined text-primary">monitoring</span>
                </div>
                <div class="mt-2 font-headline text-2xl font-extrabold text-on-surface tabular-nums">
                    @Model.Data.LotesActivosCount <span class="text-sm font-bold text-on-surface-variant">lotes activos</span>
                </div>
                <div class="mt-1 text-[11px] text-on-surface-variant font-semibold">
                    GMD prom.: <strong>@Model.Data.GmdPromedio g/d</strong> • Fertilidad: <strong>@Model.Data.TasaFertilidad.ToString("N1")%</strong> (@Model.Data.ConfirmadasEco/@Model.Data.ServiciosMes)
                </div>
            </div>

            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs flex flex-col justify-between">
                <div class="flex items-center justify-between text-xs font-bold text-on-surface-variant">
                    <span>RESERVA EN SILOS</span>
                    <span class="material-symbols-outlined text-amber-700">warehouse</span>
                </div>
                <div class="mt-2 font-headline text-2xl font-extrabold text-on-surface tabular-nums">
                    @Model.Data.ToneladasSilo.ToString("N2") t <span class="text-xs font-bold text-on-surface-variant">(@Model.Data.PorcentajeCapacidadSilos%)</span>
                </div>
                <div class="mt-1 text-[11px] text-on-surface-variant font-semibold">
                    Consumo móvil hoy: <strong>@Model.Data.AlimentoSuministradoHoyKg.ToString("N1") Kg</strong> • Jaulas: <strong>@Model.Data.JaulasOcupadas/@Model.Data.JaulasTotales</strong>
                </div>
            </div>
        </div>
    }
    else if (RoleService.EsVeterinario)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs">
                <div class="flex items-center justify-between text-xs font-bold text-on-surface-variant">
                    <span>FERTILIDAD &amp; CAMADA</span>
                    <span class="material-symbols-outlined text-teal-700">child_care</span>
                </div>
                <div class="mt-2 font-headline text-2xl font-extrabold text-on-surface tabular-nums">@Model.Data.TasaFertilidad.ToString("N1")%</div>
                <div class="mt-1 text-[11px] text-on-surface-variant font-semibold">Prom. nacidos vivos: <strong>@Model.Data.PromedioNacidosVivos.ToString("N1")</strong> (@Model.Data.ConfirmadasEco/@Model.Data.ServiciosMes serv.)</div>
            </div>

            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs">
                <div class="flex items-center justify-between text-xs font-bold text-on-surface-variant">
                    <span>SANIDAD CLÍNICA (MES)</span>
                    <span class="material-symbols-outlined text-teal-700">vaccines</span>
                </div>
                <div class="mt-2 font-headline text-2xl font-extrabold text-on-surface tabular-nums">@Model.Data.TratamientosAplicadosMes <span class="text-sm font-bold text-on-surface-variant">aplic.</span></div>
                <div class="mt-1 text-[11px] text-on-surface-variant font-semibold">Dosis: <strong>@Model.Data.DosisMedicamentosMlMes.ToString("N0") ml</strong> • Pacientes: <strong>@Model.Data.AnimalesBajoTratamiento</strong></div>
            </div>

            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs">
                <div class="flex items-center justify-between text-xs font-bold text-on-surface-variant">
                    <span>LOTES &amp; GMD PROMEDIO</span>
                    <span class="material-symbols-outlined text-primary">pets</span>
                </div>
                <div class="mt-2 font-headline text-2xl font-extrabold text-on-surface tabular-nums">@Model.Data.LotesActivosCount lotes</div>
                <div class="mt-1 text-[11px] text-on-surface-variant font-semibold">Ganancia diaria promedio: <strong>@Model.Data.GmdPromedio g/día</strong></div>
            </div>

            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs">
                <div class="flex items-center justify-between text-xs font-bold text-on-surface-variant">
                    <span>AGENDA CLÍNICA &amp; JAULAS</span>
                    <span class="material-symbols-outlined text-primary">task_alt</span>
                </div>
                <div class="mt-2 font-headline text-2xl font-extrabold text-on-surface tabular-nums">@Model.Data.TareasCompletadasHoy / @(Model.Data.TareasCompletadasHoy + Model.Data.TareasPendientesHoy)</div>
                <div class="mt-1 text-[11px] text-on-surface-variant font-semibold">Pendientes hoy: <strong>@Model.Data.TareasPendientesHoy</strong> • Ocupación: <strong>@Model.Data.JaulasOcupadas/@Model.Data.JaulasTotales</strong></div>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs">
                <div class="flex items-center justify-between text-xs font-bold text-on-surface-variant">
                    <span>MIS TAREAS DE CAMPO HOY</span>
                    <span class="material-symbols-outlined text-primary">task_alt</span>
                </div>
                <div class="mt-2 font-headline text-2xl font-extrabold text-on-surface tabular-nums">@Model.Data.TareasCompletadasHoy / @(Model.Data.TareasCompletadasHoy + Model.Data.TareasPendientesHoy)</div>
                <div class="mt-1 text-[11px] text-on-surface-variant font-semibold">Pendientes en turno: <strong>@Model.Data.TareasPendientesHoy</strong></div>
            </div>

            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs">
                <div class="flex items-center justify-between text-xs font-bold text-on-surface-variant">
                    <span>ALIMENTO SUMINISTRADO HOY</span>
                    <span class="material-symbols-outlined text-amber-700">scale</span>
                </div>
                <div class="mt-2 font-headline text-2xl font-extrabold text-on-surface tabular-nums">@Model.Data.AlimentoSuministradoHoyKg.ToString("N1") Kg</div>
                <div class="mt-1 text-[11px] text-on-surface-variant font-semibold">Despacho registrado en tolvas y bodega</div>
            </div>

            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs">
                <div class="flex items-center justify-between text-xs font-bold text-on-surface-variant">
                    <span>RESERVA EN SILOS</span>
                    <span class="material-symbols-outlined text-amber-700">warehouse</span>
                </div>
                <div class="mt-2 font-headline text-2xl font-extrabold text-on-surface tabular-nums">@Model.Data.ToneladasSilo.ToString("N2") t <span class="text-xs font-bold text-on-surface-variant">(@Model.Data.PorcentajeCapacidadSilos%)</span></div>
                <div class="mt-1 text-[11px] text-on-surface-variant font-semibold">Disponibilidad física en planta</div>
            </div>

            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs">
                <div class="flex items-center justify-between text-xs font-bold text-on-surface-variant">
                    <span>CORRALES &amp; LOTES ACTIVOS</span>
                    <span class="material-symbols-outlined text-primary">pets</span>
                </div>
                <div class="mt-2 font-headline text-2xl font-extrabold text-on-surface tabular-nums">@Model.Data.JaulasOcupadas / @Model.Data.JaulasTotales <span class="text-xs font-bold text-on-surface-variant">cabs.</span></div>
                <div class="mt-1 text-[11px] text-on-surface-variant font-semibold">Lotes en nave: <strong>@Model.Data.LotesActivosCount</strong> • GMD prom.: <strong>@Model.Data.GmdPromedio g/d</strong></div>
            </div>
        </div>
    }
    }

    <!-- Bloque Analítico de Costes (Solo Administrador) -->
    @if (RoleService.EsAdmin && HasMod("RESUMEN_FINANCIERO"))
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <section class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="font-headline text-sm font-extrabold text-on-surface">Presupuestado vs. Ejecutado por Centro de Costo</h2>
                        <p class="text-[11px] text-on-surface-variant">Alimentación, Nómina/Labores, Sanidad y Servicios imputados desde PostgreSQL</p>
                    </div>
                    <a href="/Presupuestos" class="text-xs font-bold text-primary hover:underline">Detalle &rarr;</a>
                </div>
                @if (Model.Data.BarrasCentroCosto.Count == 0)
                {
                    <div class="py-10 text-center text-xs text-on-surface-variant bg-surface-container-low rounded-xl">
                        Sin movimientos ni presupuestos por centro de costo todavía.
                    </div>
                }
                else
                {
                    <div class="h-64 relative">
                        <canvas id="chart-centros"></canvas>
                    </div>
                }
            </section>

            <section class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="font-headline text-sm font-extrabold text-on-surface">Flujo Operativo Mensual (Ingresos vs. Gastos)</h2>
                        <p class="text-[11px] text-on-surface-variant">Evolución transaccional consolidada de los últimos meses</p>
                    </div>
                    <a href="/Lotes?tab=simulador" class="text-xs font-bold text-primary hover:underline">Simulador &rarr;</a>
                </div>
                @if (Model.Data.BarrasMensuales.Count == 0)
                {
                    <div class="py-10 text-center text-xs text-on-surface-variant bg-surface-container-low rounded-xl">
                        Sin flujos mensuales registrados todavía.
                    </div>
                }
                else
                {
                    <div class="h-64 relative">
                        <canvas id="chart-flujo"></canvas>
                    </div>
                }
            </section>
        </div>
    }

    <!-- Bloque de Lógica Zootécnica en Vivo -->
    @if (HasMod("METRICAS_VIVO") || HasMod("ACCIONES_RAPIDAS") || HasMod("SILOS_NIVEL"))
    {
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
        @if (HasMod("METRICAS_VIVO"))
        {
        <!-- Eficiencia Biológica por Lote -->
        <section class="lg:col-span-7 bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-headline text-sm font-extrabold text-on-surface">Eficiencia Biológica y Semáforo ICA por Lote</h2>
                    <p class="text-[11px] text-on-surface-variant">Evaluación zootécnica real: peso, ganancia diaria (GMD) y conversión alimenticia (ICA)</p>
                </div>
                <a href="/Lotes" class="text-xs font-bold text-primary hover:underline">Ver lotes &rarr;</a>
            </div>

            @if (Model.Data.Lotes.Count == 0)
            {
                <div class="py-8 text-center text-xs text-on-surface-variant bg-surface-container-low rounded-xl">
                    No hay lotes activos registrados. <a href="/Lotes" class="text-primary font-bold underline">Crear primer lote</a>.
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-surface-container-high text-on-surface font-bold border-b border-outline-variant">
                                <th class="p-2.5">Lote / Galpón</th>
                                <th class="p-2.5">Etapa</th>
                                <th class="p-2.5 text-right">Cabezas</th>
                                <th class="p-2.5 text-right">Peso Prom.</th>
                                <th class="p-2.5 text-right">GMD</th>
                                <th class="p-2.5 text-center">Lógica ICA</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/60">
                            @foreach (var lote in Model.Data.Lotes)
                            {
                                var fcrBadge = lote.Fcr <= 0
                                    ? "bg-stone-100 text-stone-700 border-stone-300"
                                    : lote.Fcr <= 2.65m
                                        ? "bg-emerald-100 text-emerald-800 border-emerald-300"
                                        : lote.Fcr <= 3.00m
                                            ? "bg-amber-100 text-amber-800 border-amber-300"
                                            : "bg-red-100 text-red-800 border-red-300";
                                var fcrEstado = lote.Fcr <= 0 ? "En inicio" : lote.Fcr <= 2.65m ? "Óptimo" : lote.Fcr <= 3.00m ? "Revisar tolva" : "Desvío";
                                <tr class="hover:bg-surface-container-low/50">
                                    <td class="p-2.5">
                                        <div class="font-bold text-on-surface">@lote.Codigo</div>
                                        <div class="text-[10px] text-on-surface-variant">@lote.Galpon</div>
                                    </td>
                                    <td class="p-2.5 capitalize text-on-surface-variant">@lote.Etapa.Replace('_', ' ')</td>
                                    <td class="p-2.5 text-right font-bold tabular-nums">@lote.Cabezas</td>
                                    <td class="p-2.5 text-right tabular-nums">
                                        <span class="font-bold">@lote.PesoPromedioKg.ToString("N1") Kg</span>
                                        <div class="text-[10px] text-outline">@((lote.PesoPromedioKg * 2.20462m).ToString("N0")) lb</div>
                                    </td>
                                    <td class="p-2.5 text-right font-bold tabular-nums">@lote.Gmd.ToString("N0") g/d</td>
                                    <td class="p-2.5 text-center">
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold border @fcrBadge tabular-nums">
                                            @(lote.Fcr > 0 ? lote.Fcr.ToString("N2") : "—") · @fcrEstado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        }

        <!-- Radar Gestación 114d & Estado de Silos -->
        @if (((RoleService.EsAdmin || RoleService.EsVeterinario) && HasMod("ACCIONES_RAPIDAS")) || HasMod("SILOS_NIVEL"))
        {
        <section class="@(HasMod("METRICAS_VIVO") ? "lg:col-span-5" : "lg:col-span-12") flex flex-col gap-4">
            @if ((RoleService.EsAdmin || RoleService.EsVeterinario) && HasMod("ACCIONES_RAPIDAS"))
            {
            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs flex flex-col gap-2.5">
                <div class="flex items-center justify-between">
                    <h2 class="font-headline text-sm font-extrabold text-on-surface">Radar de Partos (Ciclo 114 Días)</h2>
                    <a href="/Reproduccion" class="text-xs font-bold text-primary hover:underline">Maternidad &rarr;</a>
                </div>
                @if (Model.Data.RadarPartos.Count == 0)
                {
                    <p class="text-xs text-on-surface-variant py-3">Sin cerdas gestantes próximas en este ciclo.</p>
                }
                else
                {
                    <div class="flex flex-col gap-2">
                        @foreach (var p in Model.Data.RadarPartos.Take(4))
                        {
                            <div class="p-2.5 rounded-xl bg-surface-container-low border border-outline-variant/60">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="font-bold text-on-surface">@p.Caravana <span class="text-on-surface-variant font-normal">(@p.Jaula)</span></span>
                                    <span class="font-bold text-primary tabular-nums">@p.DiasGestacion / 114d · @p.AvisoTemporal</span>
                                </div>
                                <div class="w-full h-1.5 bg-surface-container-highest rounded-full overflow-hidden mt-1.5">
                                    <div class="h-full bg-primary rounded-full" style="width: @Math.Min(100, Math.Max(4, p.PctAvance))%;"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            }

            @if (HasMod("SILOS_NIVEL"))
            {
            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs flex flex-col gap-2.5">
                <div class="flex items-center justify-between">
                    <h2 class="font-headline text-sm font-extrabold text-on-surface">Silos de Alimento</h2>
                    <a href="/Inventario" class="text-xs font-bold text-primary hover:underline">Kardex &rarr;</a>
                </div>
                @if (Model.Data.Silos.Count == 0)
                {
                    <p class="text-xs text-on-surface-variant py-2">No hay silos configurados en el inventario.</p>
                }
                else
                {
                    <div class="flex flex-col gap-2">
                        @foreach (var s in Model.Data.Silos)
                        {
                            var barCls = s.PorcentajeOcupacion < 20 ? "bg-error" : s.PorcentajeOcupacion < 40 ? "bg-amber-600" : "bg-secondary";
                            <div class="p-2.5 rounded-xl bg-surface-container-low border border-outline-variant/60">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="font-bold text-on-surface">@s.Nombre <span class="text-outline font-normal">(@s.InsumoPrincipal)</span></span>
                                    <span class="font-bold tabular-nums">@s.NivelActualKg.ToString("N0") / @s.CapacidadMaximaKg.ToString("N0") Kg (@s.PorcentajeOcupacion%)</span>
                                </div>
                                <div class="w-full h-1.5 bg-surface-container-highest rounded-full overflow-hidden mt-1.5">
                                    <div class="h-full @barCls rounded-full" style="width: @Math.Min(100, Math.Max(0, s.PorcentajeOcupacion))%;"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            }
        </section>
        }
    </div>
    }

    <!-- Sincronización Móvil de Tareas/Labores y Alertas -->
    @if (HasMod("TAREAS_HOY") || HasMod("BUSCADOR_CAMPO"))
    {
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        @if (HasMod("TAREAS_HOY"))
        {
        <section class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs flex flex-col gap-2.5">
            <div class="flex items-center justify-between">
                <h2 class="font-headline text-sm font-extrabold text-on-surface">Tareas y Labores de Campo (Hoy)</h2>
                <a href="/Calendario" class="text-xs font-bold text-primary hover:underline">Abrir monitor &rarr;</a>
            </div>
            @if (Model.Data.TareasHoy.Count == 0)
            {
                <p class="text-xs text-on-surface-variant py-4 text-center bg-surface-container-low rounded-xl">
                    Sin tareas ni labores sincronizadas para el día de hoy.
                </p>
            }
            else
            {
                <div class="flex flex-col gap-2">
                    @foreach (var t in Model.Data.TareasHoy.Take(6))
                    {
                        <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl border border-outline-variant/70 bg-surface-container-low/40 text-xs">
                            <div class="min-w-0">
                                <div class="font-bold text-on-surface truncate">@t.Titulo</div>
                                <div class="text-[11px] text-on-surface-variant truncate">@t.HoraProgramada • @t.GalponNombre @t.LoteCodigo • @t.AsignadoANombre</div>
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0">
                                @if (!t.EstaCompletada)
                                {
                                    <form method="post" asp-page-handler="CompletarTareaRapida" class="inline">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <input type="hidden" name="galponFiltro" value="@Model.GalponFiltroActivo" />
                                        <button type="submit" class="px-2 py-0.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-[10px] font-bold transition">
                                            Completar
                                        </button>
                                    </form>
                                }
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border @(t.EstaCompletada ? "bg-emerald-100 text-emerald-800 border-emerald-300" : "bg-amber-100 text-amber-800 border-amber-300")">
                                    @(t.EstaCompletada ? "Completada" : "Pendiente")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
        }

        @if (HasMod("BUSCADOR_CAMPO"))
        {
        <section class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 shadow-xs flex flex-col gap-2.5">
            <div class="flex items-center justify-between">
                <h2 class="font-headline text-sm font-extrabold text-on-surface">Alertas Lógicas &amp; Sanitarias</h2>
                <span class="text-[11px] font-bold text-on-surface-variant">@Model.Data.Alertas.Count activas</span>
            </div>
            @if (Model.Data.Alertas.Count == 0)
            {
                <p class="text-xs text-emerald-800 font-semibold py-4 text-center bg-emerald-50 rounded-xl border border-emerald-200">
                    Sin desviaciones críticas ni alertas pendientes en granja.
                </p>
            }
            else
            {
                <div class="flex flex-col gap-2">
                    @foreach (var a in Model.Data.Alertas.Take(6))
                    {
                        var cls = a.Severidad == "critica"
                            ? "bg-red-50 border-red-200 text-red-900"
                            : "bg-amber-50 border-amber-200 text-amber-900";
                        <div class="p-2.5 rounded-xl border @cls text-xs flex items-start justify-between gap-2">
                            <div>
                                <div class="font-bold">@a.Tipo</div>
                                <div class="text-[11px] opacity-90">@a.Descripcion</div>
                            </div>
                            <span class="shrink-0 font-bold tabular-nums text-[11px]">@a.ValorDetectado</span>
                        </div>
                    }
                </div>
            }
        </section>
        }
    </div>
    }
</div>

<!-- MODAL: PERSONALIZAR VISTA POR ROL -->
<div id="modal-personalizar-ui" class="fixed inset-0 z-50 bg-black/45 backdrop-blur-[2px] hidden items-center justify-center p-4">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl max-w-lg w-full p-5 shadow-2xl max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-outline-variant pb-3 mb-4">
            <div>
                <h2 class="font-headline text-base font-extrabold text-on-surface">Personalizar Interfaz (@pref.RolBase)</h2>
                <p class="text-[11px] text-on-surface-variant">Configuración persistida en PostgreSQL y sincronizada con tus permisos de rol.</p>
            </div>
            <button type="button" onclick="cerrarModalPersonalizarUi()" class="p-1 rounded-lg text-on-surface-variant hover:text-on-surface">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="flex flex-col gap-4 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold mb-1 text-on-surface">Galpón Predeterminado</label>
                    <select id="ui-pref-galpon" class="w-full rounded-xl border border-outline-variant bg-surface px-3 py-2 font-semibold">
                        <option value="">Toda la Granja</option>
                        @foreach (var g in Model.GalponesSelector)
                        {
                            <option value="@g.Codigo" selected="@(pref.GalponPredeterminado == g.Codigo)">@g.Nombre (@g.TipoSistema)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block font-bold mb-1 text-on-surface">Turno Habitual</label>
                    <select id="ui-pref-turno" class="w-full rounded-xl border border-outline-variant bg-surface px-3 py-2 font-semibold">
                        @foreach (var t in Model.TurnosSelector)
                        {
                            <option value="@t.Codigo" selected="@(pref.TurnoPredeterminado == t.Codigo)">@t.Nombre</option>
                        }
                    </select>
                </div>
            </div>

            <div>
                <span class="block font-bold mb-1.5 text-on-surface">Secciones Visibles en el Tablero</span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <label class="flex items-center gap-2 p-2.5 rounded-xl border border-outline-variant bg-surface-container-low cursor-pointer">
                        <input type="checkbox" class="ui-mod-check rounded text-primary" value="METRICAS_VIVO" @(HasMod("METRICAS_VIVO") ? "checked" : "") />
                        <span class="font-semibold">KPIs y Semáforo ICA</span>
                    </label>
                    @if (RoleService.EsAdmin || RoleService.EsVeterinario)
                    {
                        <label class="flex items-center gap-2 p-2.5 rounded-xl border border-outline-variant bg-surface-container-low cursor-pointer">
                            <input type="checkbox" class="ui-mod-check rounded text-primary" value="ACCIONES_RAPIDAS" @(HasMod("ACCIONES_RAPIDAS") ? "checked" : "") />
                            <span class="font-semibold">Radar de Partos (114d)</span>
                        </label>
                    }
                    <label class="flex items-center gap-2 p-2.5 rounded-xl border border-outline-variant bg-surface-container-low cursor-pointer">
                        <input type="checkbox" class="ui-mod-check rounded text-primary" value="SILOS_NIVEL" @(HasMod("SILOS_NIVEL") ? "checked" : "") />
                        <span class="font-semibold">Nivel de Silos</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-xl border border-outline-variant bg-surface-container-low cursor-pointer">
                        <input type="checkbox" class="ui-mod-check rounded text-primary" value="TAREAS_HOY" @(HasMod("TAREAS_HOY") ? "checked" : "") />
                        <span class="font-semibold">Agenda &amp; Tareas de Hoy</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-xl border border-outline-variant bg-surface-container-low cursor-pointer">
                        <input type="checkbox" class="ui-mod-check rounded text-primary" value="BUSCADOR_CAMPO" @(HasMod("BUSCADOR_CAMPO") ? "checked" : "") />
                        <span class="font-semibold">Alertas Sanitarias</span>
                    </label>
                    @if (RoleService.EsAdmin)
                    {
                        <label class="flex items-center gap-2 p-2.5 rounded-xl border border-primary/40 bg-primary-fixed/25 cursor-pointer">
                            <input type="checkbox" class="ui-mod-check rounded text-primary" value="RESUMEN_FINANCIERO" @(HasMod("RESUMEN_FINANCIERO") ? "checked" : "") />
                            <span class="font-semibold text-primary">Gráficos Costos (Admin)</span>
                        </label>
                    }
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-outline-variant bg-surface-container-low cursor-pointer">
                    <input type="checkbox" id="ui-pref-compacto" class="rounded text-primary" @(pref.ModoCompacto ? "checked" : "") />
                    <span class="font-semibold">Modo Compacto de Tablero</span>
                </label>

                @if (RoleService.EsAdmin)
                {
                    <div>
                        <label class="block font-bold mb-1 text-on-surface">Moneda Preferida</label>
                        <select id="ui-pref-moneda" class="w-full rounded-xl border border-outline-variant bg-surface px-3 py-2 font-semibold">
                            <option value="NIO" selected="@(monedaPref == "NIO")">Córdobas (C$)</option>
                            <option value="USD" selected="@(monedaPref == "USD")">Dólares ($ USD)</option>
                        </select>
                    </div>
                }
            </div>

            <div id="ui-pref-error" class="hidden p-2.5 rounded-xl bg-red-50 border border-red-200 text-red-800 text-[11px] font-semibold"></div>

            <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-outline-variant">
                <button type="button" onclick="restablecerPreferenciasUi()" class="px-3 py-2 rounded-xl border border-outline-variant font-bold text-on-surface-variant hover:bg-surface-container-low">
                    Restablecer por rol
                </button>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="cerrarModalPersonalizarUi()" class="px-3 py-2 rounded-xl border border-outline-variant font-bold">Cancelar</button>
                    <button type="button" onclick="guardarPreferenciasUi()" class="px-4 py-2 rounded-xl bg-primary text-on-primary font-bold hover:bg-secondary">Guardar Preferencias</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const currentUiPrefs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pref, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

        function abrirModalPersonalizarUi() {
            const m = document.getElementById('modal-personalizar-ui');
            if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
        }
        function cerrarModalPersonalizarUi() {
            const m = document.getElementById('modal-personalizar-ui');
            if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
        }
        async function enviarPreferenciasUi(payload) {
            const err = document.getElementById('ui-pref-error');
            if (err) err.classList.add('hidden');
            try {
                const res = await fetch('/api/v1/preferencias-ui', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                window.location.reload();
            } catch (e) {
                if (err) {
                    err.textContent = 'No se pudieron guardar las preferencias (' + e.message + ').';
                    err.classList.remove('hidden');
                }
            }
        }
        function guardarPreferenciasUi() {
            const modulos = Array.from(document.querySelectorAll('.ui-mod-check:checked')).map(c => c.value);
            const monedaSel = document.getElementById('ui-pref-moneda');
            const payload = {
                ...currentUiPrefs,
                galponPredeterminado: document.getElementById('ui-pref-galpon')?.value || '',
                turnoPredeterminado: document.getElementById('ui-pref-turno')?.value || currentUiPrefs.turnoPredeterminado,
                modulosVisibles: modulos,
                modoCompacto: !!document.getElementById('ui-pref-compacto')?.checked,
                monedaPreferida: monedaSel ? monedaSel.value : 'NIO',
                updatedAtMs: Date.now()
            };
            enviarPreferenciasUi(payload);
        }
        function restablecerPreferenciasUi() {
            enviarPreferenciasUi({
                rolBase: currentUiPrefs.rolBase,
                modulosVisibles: [],
                accionesRapidas: [],
                navInferior: [],
                galponPredeterminado: '',
                turnoPredeterminado: '',
                monedaPreferida: 'NIO',
                modoCompacto: false,
                updatedAtMs: Date.now()
            });
        }
    </script>
    @if (RoleService.EsAdmin)
    {
        <script>
            const TASA_CAMBIO = 36.80;
            const centrosData = @Html.Raw(centrosJson);
            const flujoData = @Html.Raw(flujoJson);
            let chartCentros = null;
            let chartFlujo = null;
            let monedaActiva = '@monedaPref';

            function factorMoneda() { return monedaActiva === 'NIO' ? TASA_CAMBIO : 1; }
            function simboloMoneda() { return monedaActiva === 'NIO' ? 'C$ ' : '$ '; }

            function setMonedaConsola(moneda) {
                monedaActiva = moneda;
                const btnUsd = document.getElementById('btn-moneda-usd');
                const btnNio = document.getElementById('btn-moneda-nio');
                if (moneda === 'USD') {
                    btnUsd.className = 'px-3 py-1.5 rounded-lg bg-primary text-on-primary transition-all';
                    btnNio.className = 'px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface transition-all';
                } else {
                    btnNio.className = 'px-3 py-1.5 rounded-lg bg-primary text-on-primary transition-all';
                    btnUsd.className = 'px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface transition-all';
                }

                const mult = factorMoneda();
                const sym = simboloMoneda();
                document.querySelectorAll('.money-usd').forEach(el => {
                    const usd = parseFloat(el.dataset.usd || '0') || 0;
                    el.textContent = sym + (usd * mult).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                });

                renderCharts();
            }

            function renderCharts() {
                const mult = factorMoneda();
                const sym = simboloMoneda();

                const ctxCentros = document.getElementById('chart-centros');
                if (ctxCentros && centrosData.length > 0) {
                    if (chartCentros) chartCentros.destroy();
                    chartCentros = new Chart(ctxCentros, {
                        type: 'bar',
                        data: {
                            labels: centrosData.map(c => c.Nombre),
                            datasets: [
                                {
                                    label: 'Presupuestado',
                                    data: centrosData.map(c => Number((c.PresupuestadoUsd * mult).toFixed(2))),
                                    backgroundColor: '#becca3',
                                    borderRadius: 6
                                },
                                {
                                    label: 'Ejecutado',
                                    data: centrosData.map(c => Number((c.EjecutadoUsd * mult).toFixed(2))),
                                    backgroundColor: '#566342',
                                    borderRadius: 6
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'bottom' },
                                tooltip: { callbacks: { label: c => `${c.dataset.label}: ${sym}${Number(c.raw).toLocaleString('en-US', { minimumFractionDigits: 2 })}` } }
                            }
                        }
                    });
                }

                const ctxFlujo = document.getElementById('chart-flujo');
                if (ctxFlujo && flujoData.length > 0) {
                    if (chartFlujo) chartFlujo.destroy();
                    chartFlujo = new Chart(ctxFlujo, {
                        type: 'bar',
                        data: {
                            labels: flujoData.map(m => `${m.MesNombre} ${m.Anio}`),
                            datasets: [
                                {
                                    label: 'Ingresos',
                                    data: flujoData.map(m => Number((m.IngresosUsd * mult).toFixed(2))),
                                    backgroundColor: '#45664b',
                                    borderRadius: 6
                                },
                                {
                                    label: 'Gastos',
                                    data: flujoData.map(m => Number((m.GastosUsd * mult).toFixed(2))),
                                    backgroundColor: '#ba1a1a',
                                    borderRadius: 6
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'bottom' },
                                tooltip: { callbacks: { label: c => `${c.dataset.label}: ${sym}${Number(c.raw).toLocaleString('en-US', { minimumFractionDigits: 2 })}` } }
                            }
                        }
                    });
                }
            }

            document.addEventListener('DOMContentLoaded', () => setMonedaConsola(monedaActiva));
        </script>
    }
}
