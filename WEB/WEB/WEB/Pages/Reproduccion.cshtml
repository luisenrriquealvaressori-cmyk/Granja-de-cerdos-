@page
@model WEB.Pages.ReproduccionModel
@inject WEB.Services.UserRoleService RoleService
@{
    ViewData["Title"] = "Ciclo Reproductivo 114d - 21d - 7d";

    var totalPartosHist = Model.Data.HistorialPartos.Count;
    var avgNv = totalPartosHist > 0 ? Math.Round(Model.Data.HistorialPartos.Average(h => (decimal)h.NacidosVivos), 1) : 0m;
    var avgPesoLechon = totalPartosHist > 0 ? Math.Round(Model.Data.HistorialPartos.Average(h => h.PesoPromedioLechonKg), 2) : 0m;
    var tasaViabilidadGlobal = totalPartosHist > 0 && Model.Data.HistorialPartos.Sum(h => h.TotalNacidos) > 0
        ? Math.Round((decimal)Model.Data.HistorialPartos.Sum(h => h.NacidosVivos) * 100m / Model.Data.HistorialPartos.Sum(h => h.TotalNacidos), 1)
        : 0m;
}

<div class="p-4 sm:p-6 space-y-6">
    <!-- 1. ENCABEZADO -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-outline-variant pb-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-teal-700 mb-1">
                <span class="material-symbols-outlined text-[16px]">cycle</span>
                <span>Lógica Zootécnica · Maternidad &amp; Gestación</span>
            </div>
            <h1 class="text-2xl font-bold font-headline text-on-surface tracking-tight">
                Ciclo Reproductivo (114d – 21d – 7d)
            </h1>
            <p class="text-xs text-on-surface-variant mt-0.5">
                Seguimiento del ciclo biológico porcino sincronizado desde eventos de campo (<code class="font-mono bg-surface-container px-1 py-0.5 rounded">SERVICIO_IA</code>, <code class="font-mono bg-surface-container px-1 py-0.5 rounded">PARTO</code> y <code class="font-mono bg-surface-container px-1 py-0.5 rounded">DESTETE</code>).
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            @if (RoleService.PuedeRegistrarPartos)
            {
                <button type="button" onclick="abrirModalServicioIA()"
                        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-primary/40 bg-primary-fixed/40 text-primary text-xs font-bold hover:bg-primary hover:text-on-primary transition">
                    <span class="material-symbols-outlined text-[16px]">biotech</span>
                    <span>Registrar Servicio IA</span>
                </button>
                <button type="button" onclick="abrirModalRegistrarParto()"
                        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-teal-700 text-white text-xs font-bold hover:bg-teal-800 transition shadow-xs">
                    <span class="material-symbols-outlined text-[16px]">child_care</span>
                    <span>Registrar Parto</span>
                </button>
            }
            else
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-surface-container text-on-surface-variant text-xs font-medium border border-outline-variant">
                    <span class="material-symbols-outlined text-[15px]">visibility</span>
                    <span>Modo Consulta · Registro clínico móvil / Veterinario</span>
                </span>
            }
        </div>
    </div>

    <!-- ALERTAS DE OPERACIÓN -->
    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-950 flex items-center gap-2.5 text-xs font-medium shadow-2xs">
            <span class="material-symbols-outlined text-emerald-700 text-[20px]">check_circle</span>
            <span>@Model.MensajeExito</span>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="p-3.5 rounded-xl bg-error-container/60 border border-error text-on-error-container flex items-center gap-2.5 text-xs font-medium shadow-2xs">
            <span class="material-symbols-outlined text-error text-[20px]">error</span>
            <span>@Model.MensajeError</span>
        </div>
    }

    <!-- 2. FLUJO VISUAL DE LÓGICA BIOLÓGICA (114d - 21d - 7d) -->
    <section class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-4 sm:p-5 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
            <div>
                <h2 class="text-sm font-bold font-headline text-on-surface flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-primary text-[18px]">timeline</span>
                    <span>Flujo Estándar de Productividad por Cerda (~142 días/ciclo · 2.4 partos/año)</span>
                </h2>
                <p class="text-[11px] text-on-surface-variant">Distribución real del hato activo en cada etapa fisiológica</p>
            </div>
            @if (totalPartosHist > 0)
            {
                <div class="flex items-center gap-3 text-xs">
                    <span class="px-2.5 py-1 rounded-lg bg-teal-50 text-teal-900 border border-teal-200 font-semibold font-mono">
                        Prom. @avgNv.ToString("N1") NV/camada
                    </span>
                    <span class="px-2.5 py-1 rounded-lg bg-surface-container text-on-surface border border-outline-variant font-semibold font-mono">
                        Viabilidad @tasaViabilidadGlobal.ToString("N1")%
                    </span>
                </div>
            }
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
            <!-- Etapa 1: Vacía / Celo -->
            <div class="p-3 rounded-xl border border-amber-300/70 bg-amber-50/40 flex flex-col justify-between">
                <div class="flex items-center justify-between text-[11px] font-bold text-amber-900">
                    <span>1. Vacía / Post-Destete</span>
                    <span class="font-mono px-1.5 py-0.5 rounded bg-amber-200/70">Días 0–7</span>
                </div>
                <div class="my-2">
                    <span class="text-2xl font-bold font-headline text-on-surface tabular-nums">@Model.Data.CerdasVacias</span>
                    <span class="text-[11px] text-on-surface-variant ml-1">hembras</span>
                </div>
                <p class="text-[10px] text-on-surface-variant">Ventana de celo e Inseminación IA (Día 5–7 post-destete)</p>
            </div>

            <!-- Etapa 2: Gestación -->
            <div class="p-3 rounded-xl border border-primary/40 bg-primary-fixed/20 flex flex-col justify-between">
                <div class="flex items-center justify-between text-[11px] font-bold text-primary">
                    <span>2. Gestación Activa</span>
                    <span class="font-mono px-1.5 py-0.5 rounded bg-primary/15">Día 1–106</span>
                </div>
                <div class="my-2">
                    <span class="text-2xl font-bold font-headline text-on-surface tabular-nums">@Model.Data.CerdasGestantes</span>
                    <span class="text-[11px] text-on-surface-variant ml-1">hembras</span>
                </div>
                <p class="text-[10px] text-on-surface-variant">Ecografía Día +28 · Refuerzo sanitario Día +85</p>
            </div>

            <!-- Etapa 3: Radar Inminente -->
            <div class="p-3 rounded-xl border border-error/40 bg-error-container/20 flex flex-col justify-between">
                <div class="flex items-center justify-between text-[11px] font-bold text-error">
                    <span>3. Sala de Parto</span>
                    <span class="font-mono px-1.5 py-0.5 rounded bg-error/15">Día 107–114</span>
                </div>
                <div class="my-2">
                    <span class="text-2xl font-bold font-headline text-error tabular-nums">@Model.Data.RadarPartos.Count</span>
                    <span class="text-[11px] text-on-surface-variant ml-1">en radar</span>
                </div>
                <p class="text-[10px] text-on-surface-variant">Traslado a jaula de maternidad y vigilancia de parto</p>
            </div>

            <!-- Etapa 4: Lactancia -->
            <div class="p-3 rounded-xl border border-teal-400/60 bg-teal-50/50 flex flex-col justify-between">
                <div class="flex items-center justify-between text-[11px] font-bold text-teal-900">
                    <span>4. Lactancia</span>
                    <span class="font-mono px-1.5 py-0.5 rounded bg-teal-200/60">+21 días</span>
                </div>
                <div class="my-2">
                    <span class="text-2xl font-bold font-headline text-on-surface tabular-nums">@Model.Data.CerdasLactantes</span>
                    <span class="text-[11px] text-on-surface-variant ml-1">nodrizas</span>
                </div>
                <p class="text-[10px] text-on-surface-variant">Calostro, hierro a lechones y destete hacia Precebo</p>
            </div>

            <!-- Etapa 5: Reemplazo -->
            <div class="p-3 rounded-xl border border-outline-variant bg-surface-container-low flex flex-col justify-between">
                <div class="flex items-center justify-between text-[11px] font-bold text-on-surface">
                    <span>5. Primerizas / Reemplazo</span>
                    <span class="font-mono px-1.5 py-0.5 rounded bg-surface-container-high">Renovación</span>
                </div>
                <div class="my-2">
                    <span class="text-2xl font-bold font-headline text-on-surface tabular-nums">@Model.Data.CerdasReemplazo</span>
                    <span class="text-[11px] text-on-surface-variant ml-1">cachorras</span>
                </div>
                <p class="text-[10px] text-on-surface-variant">Aclimatación y preparación al primer servicio (&ge;135 kg)</p>
            </div>
        </div>
    </section>

    <!-- 3. KPI SUMMARY CARDS -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-3">
        <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 shadow-2xs">
            <div class="text-[11px] font-semibold text-on-surface-variant uppercase">Plantel Activo</div>
            <div class="text-2xl font-bold font-headline text-on-surface mt-1 tabular-nums">@Model.Data.TotalPlantelActivo</div>
            <div class="text-[11px] text-outline mt-0.5">Hembras registradas</div>
        </div>
        <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 shadow-2xs">
            <div class="text-[11px] font-semibold text-on-surface-variant uppercase">Gestantes</div>
            <div class="text-2xl font-bold font-headline text-primary mt-1 tabular-nums">@Model.Data.CerdasGestantes</div>
            <div class="text-[11px] text-outline mt-0.5">En curso 114 días</div>
        </div>
        <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 shadow-2xs">
            <div class="text-[11px] font-semibold text-on-surface-variant uppercase">En Lactancia</div>
            <div class="text-2xl font-bold font-headline text-teal-800 mt-1 tabular-nums">@Model.Data.CerdasLactantes</div>
            <div class="text-[11px] text-outline mt-0.5">Maternidad activa</div>
        </div>
        <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 shadow-2xs">
            <div class="text-[11px] font-semibold text-on-surface-variant uppercase">Listas p/ Servicio</div>
            <div class="text-2xl font-bold font-headline text-amber-700 mt-1 tabular-nums">@Model.Data.CerdasVacias</div>
            <div class="text-[11px] text-outline mt-0.5">Vacías / Detección celo</div>
        </div>
        <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 shadow-2xs col-span-2 lg:col-span-1">
            <div class="text-[11px] font-semibold text-on-surface-variant uppercase">Peso Prom. Lechón</div>
            <div class="text-2xl font-bold font-headline text-on-surface mt-1 tabular-nums">
                @(totalPartosHist > 0 ? $"{avgPesoLechon:N2} kg" : "—")
            </div>
            <div class="text-[11px] text-outline mt-0.5">@totalPartosHist parto(s) registrados</div>
        </div>
    </div>

    <!-- 4. TABS PRINCIPALES -->
    <div class="flex items-center gap-2 border-b border-outline-variant pb-1 overflow-x-auto">
        <button type="button" id="btn-tab-radar" onclick="cambiarTabRepro('radar')"
                class="tab-repro-btn px-4 py-2 rounded-t-xl text-xs font-bold border-b-2 border-primary text-primary bg-primary-fixed/30 flex items-center gap-1.5 whitespace-nowrap">
            <span class="material-symbols-outlined text-[16px]">radar</span>
            <span>Radar de Partos 114d (@Model.Data.RadarPartos.Count)</span>
        </button>
        <button type="button" id="btn-tab-padron" onclick="cambiarTabRepro('padron')"
                class="tab-repro-btn px-4 py-2 rounded-t-xl text-xs font-bold border-b-2 border-transparent text-on-surface-variant hover:text-on-surface flex items-center gap-1.5 whitespace-nowrap">
            <span class="material-symbols-outlined text-[16px]">female</span>
            <span>Padrón Reproductivo (@Model.Data.Cerdas.Count)</span>
        </button>
        <button type="button" id="btn-tab-historial" onclick="cambiarTabRepro('historial')"
                class="tab-repro-btn px-4 py-2 rounded-t-xl text-xs font-bold border-b-2 border-transparent text-on-surface-variant hover:text-on-surface flex items-center gap-1.5 whitespace-nowrap">
            <span class="material-symbols-outlined text-[16px]">history_edu</span>
            <span>Historial de Camadas (@Model.Data.HistorialPartos.Count)</span>
        </button>
    </div>

    <!-- TAB 1: RADAR DE PARTOS 114d -->
    <div id="tab-radar" class="tab-repro-panel space-y-4">
        @if (Model.Data.RadarPartos.Count == 0)
        {
            <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-10 text-center space-y-2">
                <span class="material-symbols-outlined text-4xl text-outline">event_available</span>
                <h3 class="text-sm font-bold text-on-surface">Sin partos inminentes en la ventana actual</h3>
                <p class="text-xs text-on-surface-variant max-w-md mx-auto">
                    Cuando existan hembras entre los días 100 y 116 de gestación aparecerán aquí con su barra de progreso de 114 días para traslado a maternidad.
                </p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                @foreach (var p in Model.Data.RadarPartos)
                {
                    var pctBar = Math.Clamp((int)Math.Round(p.PctAvance), 0, 100);
                    var esCritico = p.DiasParaParto <= 2;
                    <div class="bg-surface-container-lowest border @(esCritico ? "border-error/60" : "border-outline-variant") rounded-2xl p-4 shadow-2xs flex flex-col justify-between gap-3">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="text-base font-bold font-mono text-on-surface">@p.Caravana</span>
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-surface-container text-on-surface">
                                        Paridad @p.Paridad
                                    </span>
                                </div>
                                <div class="text-[11px] text-on-surface-variant mt-0.5">
                                    Jaula: <strong class="font-mono text-on-surface">@p.Jaula</strong> · Verraco: <strong>@p.Verraco</strong>
                                </div>
                            </div>
                            <span class="px-2 py-1 rounded-lg text-[10px] font-bold @(esCritico ? "bg-error-container text-on-error-container" : "bg-amber-100 text-amber-900")">
                                @p.AvisoTemporal
                            </span>
                        </div>

                        <div class="space-y-1">
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-on-surface-variant">Avance gestación</span>
                                <span class="font-mono font-bold @(esCritico ? "text-error" : "text-primary")">
                                    Día @p.DiasGestacion / 114 (@p.PctAvance.ToString("N0")%)
                                </span>
                            </div>
                            <div class="w-full h-2 rounded-full bg-surface-container overflow-hidden">
                                <div class="h-full rounded-full @(esCritico ? "bg-error" : "bg-primary")" style="width: @pctBar%"></div>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-2 border-t border-outline-variant/60">
                            <span class="text-[11px] text-teal-800 font-semibold">@p.EstatusSanitario</span>
                            @if (RoleService.PuedeRegistrarPartos)
                            {
                                <button type="button" onclick="abrirModalRegistrarParto('@p.CerdaId', '@p.Caravana', '@p.Jaula', @p.Paridad)"
                                        class="px-3 py-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 text-white text-[11px] font-bold flex items-center gap-1 transition">
                                    <span class="material-symbols-outlined text-[14px]">child_care</span>
                                    <span>Asentar Parto</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- TAB 2: PADRÓN REPRODUCTIVO -->
    <div id="tab-padron" class="tab-repro-panel hidden">
        <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl shadow-2xs overflow-hidden">
            <div class="p-4 border-b border-outline-variant flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                    <h2 class="text-sm font-bold font-headline text-on-surface">Padrón de Hembras Reproductoras</h2>
                    <p class="text-[11px] text-on-surface-variant">Inventario real desde <code class="font-mono">cerdas_reproductoras</code></p>
                </div>
                <input type="text" id="filtro-cerda-padron" oninput="filtrarPadronCerdas()"
                       placeholder="Buscar caravana, genética o estado..."
                       class="h-9 px-3 rounded-xl border border-outline-variant text-xs w-full sm:w-64 focus:ring-1 focus:ring-primary" />
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-surface-container-low border-b border-outline-variant text-[11px] font-bold text-on-surface-variant uppercase tracking-wider">
                            <th class="py-2.5 px-4">Caravana / RFID</th>
                            <th class="py-2.5 px-4">Línea Genética</th>
                            <th class="py-2.5 px-3 text-center">Paridad</th>
                            <th class="py-2.5 px-3">Estado</th>
                            <th class="py-2.5 px-3 text-right">Prolificidad Media</th>
                            <th class="py-2.5 px-3">Estatus Sanitario</th>
                            @if (RoleService.PuedeRegistrarPartos)
                            {
                                <th class="py-2.5 px-4 text-right">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-container" id="tbody-padron-cerdas">
                        @if (Model.Data.Cerdas.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="py-10 text-center text-on-surface-variant">
                                    No hay hembras registradas en el hato reproductivo.
                                </td>
                            </tr>
                        }
                        @foreach (var c in Model.Data.Cerdas)
                        {
                            var estadoClean = (c.Estado ?? "").Replace("_", " ");
                            var estadoLower = (c.Estado ?? "").ToLowerInvariant();
                            var badgeEstado = estadoLower.Contains("gest") ? "bg-primary-fixed text-primary" :
                                estadoLower.Contains("lact") ? "bg-teal-100 text-teal-900" :
                                estadoLower.Contains("reemp") ? "bg-surface-container-high text-on-surface" :
                                "bg-amber-100 text-amber-900";
                            <tr class="hover:bg-surface-container-low/50 transition-colors fila-padron-cerda"
                                data-search="@($"{c.Caravana} {c.Rfid} {c.Genetica} {estadoClean}".ToLowerInvariant())">
                                <td class="py-3 px-4 font-mono">
                                    <div class="font-bold text-on-surface">@c.Caravana</div>
                                    <div class="text-[10px] text-outline">@(string.IsNullOrWhiteSpace(c.Rfid) ? "Sin RFID" : c.Rfid)</div>
                                </td>
                                <td class="py-3 px-4 font-medium text-on-surface">@c.Genetica</td>
                                <td class="py-3 px-3 text-center font-mono font-bold">@c.Paridad</td>
                                <td class="py-3 px-3">
                                    <span class="px-2 py-0.5 rounded-md text-[11px] font-bold uppercase @badgeEstado">
                                        @estadoClean
                                    </span>
                                </td>
                                <td class="py-3 px-3 text-right font-mono font-semibold">@c.Prolificidad.ToString("N1") NV</td>
                                <td class="py-3 px-3 text-teal-800 font-medium">@c.EstatusSanitario</td>
                                @if (RoleService.PuedeRegistrarPartos)
                                {
                                    <td class="py-3 px-4 text-right whitespace-nowrap">
                                        <div class="inline-flex items-center gap-1.5">
                                            <button type="button" onclick="abrirModalServicioIA('@c.Caravana')"
                                                    class="px-2.5 py-1 rounded-lg bg-primary-fixed/50 hover:bg-primary hover:text-on-primary text-primary text-[11px] font-bold transition">
                                                + IA
                                            </button>
                                            <button type="button" onclick="abrirModalRegistrarParto('@c.Id', '@c.Caravana', '', @c.Paridad)"
                                                    class="px-2.5 py-1 rounded-lg bg-teal-50 hover:bg-teal-700 hover:text-white text-teal-900 text-[11px] font-bold transition">
                                                + Parto
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 3: HISTORIAL DE CAMADAS -->
    <div id="tab-historial" class="tab-repro-panel hidden">
        <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl shadow-2xs overflow-hidden">
            <div class="p-4 border-b border-outline-variant flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-bold font-headline text-on-surface">Historial de Partos y Biometría de Camadas</h2>
                    <p class="text-[11px] text-on-surface-variant">Registro obstétrico consolidado (Web + Móvil)</p>
                </div>
                <span class="text-xs font-mono text-outline">@Model.Data.HistorialPartos.Count registro(s)</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs tabular-nums">
                    <thead>
                        <tr class="bg-surface-container-low border-b border-outline-variant text-[11px] font-bold text-on-surface-variant uppercase tracking-wider">
                            <th class="py-2.5 px-4">Madre &amp; Jaula</th>
                            <th class="py-2.5 px-4">Fecha</th>
                            <th class="py-2.5 px-3 text-center">Vivos</th>
                            <th class="py-2.5 px-3 text-center">Muertos / Momias</th>
                            <th class="py-2.5 px-3 text-center">Total / Viab.</th>
                            <th class="py-2.5 px-3 text-right">Peso Camada</th>
                            <th class="py-2.5 px-3 text-right">Prom. Lechón</th>
                            <th class="py-2.5 px-3 text-center">CC</th>
                            <th class="py-2.5 px-4">Responsable / Notas</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-container">
                        @if (Model.Data.HistorialPartos.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="py-10 text-center text-on-surface-variant">
                                    Aún no hay partos registrados en PostgreSQL.
                                </td>
                            </tr>
                        }
                        @foreach (var h in Model.Data.HistorialPartos)
                        {
                            var viab = h.TotalNacidos > 0 ? Math.Round((decimal)h.NacidosVivos * 100m / h.TotalNacidos, 1) : 0m;
                            var pesoCls = h.PesoPromedioLechonKg >= 1.35m ? "text-primary font-bold" : h.PesoPromedioLechonKg >= 1.15m ? "text-on-surface font-semibold" : "text-error font-bold";
                            <tr class="hover:bg-surface-container-low/50 transition-colors">
                                <td class="py-3 px-4 font-mono">
                                    <div class="font-bold text-on-surface">@h.Caravana</div>
                                    <div class="text-[10px] text-outline">Jaula: @h.Jaula</div>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="font-medium text-on-surface">@h.FechaHora.ToString("dd MMM yyyy")</div>
                                    <div class="text-[10px] text-outline font-mono">@h.FechaHora.ToString("HH:mm")</div>
                                </td>
                                <td class="py-3 px-3 text-center">
                                    <span class="px-2 py-0.5 rounded-full bg-teal-100 text-teal-900 font-bold">@h.NacidosVivos NV</span>
                                </td>
                                <td class="py-3 px-3 text-center">
                                    <div>@h.NacidosMuertos mort.</div>
                                    <div class="text-[10px] text-outline">@h.Momias momias</div>
                                </td>
                                <td class="py-3 px-3 text-center font-mono font-bold">
                                    <div>@h.TotalNacidos</div>
                                    <div class="text-[10px] font-normal text-secondary">@viab%</div>
                                </td>
                                <td class="py-3 px-3 text-right font-mono font-semibold">@h.PesoTotalCamadaKg.ToString("N1") kg</td>
                                <td class="py-3 px-3 text-right font-mono @pesoCls">@h.PesoPromedioLechonKg.ToString("N2") kg</td>
                                <td class="py-3 px-3 text-center">
                                    <span class="px-2 py-0.5 rounded bg-surface-container text-on-surface font-semibold">
                                        @h.CondicionCorporal.ToString("N1")
                                    </span>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">@h.AtendidoPor</div>
                                    <div class="text-[10px] text-outline truncate max-w-xs" title="@h.Observaciones">
                                        @(string.IsNullOrWhiteSpace(h.Observaciones) ? (h.AsistenciaObstetrica ? "Parto asistido" : "Eutócico") : h.Observaciones)
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: REGISTRAR SERVICIO IA / MONTA -->
<div id="modal-registrar-servicio" class="fixed inset-0 z-50 bg-[#1c2a1e]/45 backdrop-blur-[2px] hidden items-center justify-center p-4">
    <div class="w-full max-w-xl bg-surface-container-lowest rounded-2xl shadow-2xl border border-outline-variant overflow-hidden flex flex-col">
        <div class="p-5 border-b border-outline-variant bg-surface-container-low flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-primary text-on-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">biotech</span>
                </div>
                <div>
                    <h3 class="font-headline font-bold text-base text-on-surface">Registrar Servicio de Inseminación (IA) / Monta</h3>
                    <p class="text-[11px] text-on-surface-variant">Calcula automáticamente Ecografía (+28d), Sala (+107d) y Parto (+114d)</p>
                </div>
            </div>
            <button type="button" onclick="cerrarModalServicioIA()" class="text-on-surface-variant hover:text-on-surface">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <form method="post" asp-page-handler="RegistrarServicio" class="p-5 space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-on-surface mb-1">Caravana Reproductora *</label>
                    <select name="caravana" id="ia-caravana" required class="w-full h-9 px-3 rounded-lg border border-outline-variant text-xs font-mono font-semibold text-on-surface">
                        @foreach (var c in Model.Data.Cerdas)
                        {
                            <option value="@c.Caravana">@c.Caravana (Paridad @c.Paridad · @c.Estado.Replace("_", " "))</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-on-surface mb-1">Verraco / Dosis Semen *</label>
                    <select name="verracoId" required class="w-full h-9 px-3 rounded-lg border border-outline-variant text-xs font-medium text-on-surface">
                        @foreach (var v in Model.Data.Verracos)
                        {
                            <option value="@v.Id">@v.Nombre (@v.Codigo)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-on-surface mb-1">Técnica (BD)</label>
                    <select name="tecnica" class="w-full h-9 px-2.5 rounded-lg border border-outline-variant text-xs text-on-surface">
                        @if (Model.Catalogos.TecnicasIa.Count > 0)
                        {
                            @foreach (var t in Model.Catalogos.TecnicasIa)
                            {
                                var valTecnica = string.IsNullOrWhiteSpace(t.Subcategoria) ? t.Nombre : t.Subcategoria;
                                <option value="@valTecnica">@t.Nombre</option>
                            }
                        }
                        else
                        {
                            <option value="inseminacion_post_cervical" selected>Post-Cervical (PCAI)</option>
                            <option value="inseminacion_cervical">Cervical Clásica</option>
                            <option value="monta_natural">Monta Natural</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-on-surface mb-1">Turno / Dosis (BD)</label>
                    <select name="turno" class="w-full h-9 px-2.5 rounded-lg border border-outline-variant text-xs text-on-surface">
                        @if (Model.Catalogos.DosisIaHorarios.Count > 0)
                        {
                            @foreach (var h in Model.Catalogos.DosisIaHorarios)
                            {
                                var valTurno = h.Codigo switch {
                                    "IA-1-MAN" => "1_dosis_manana",
                                    "IA-2-TAR" => "2_dosis_tarde",
                                    "IA-3-REF" => "3_dosis_refuerzo",
                                    _ => h.Nombre
                                };
                                <option value="@valTurno">@h.Nombre</option>
                            }
                        }
                        else
                        {
                            <option value="1_dosis_manana" selected>1ra Dosis (Mañana)</option>
                            <option value="2_dosis_tarde">2da Dosis (Tarde)</option>
                            <option value="3_dosis_refuerzo">3ra Dosis (Refuerzo)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-on-surface mb-1">Fecha Servicio *</label>
                    <input type="date" name="fecha" id="ia-fecha" required value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           onchange="calcularCicloReproductivo()"
                           class="w-full h-9 px-2.5 rounded-lg border border-outline-variant text-xs font-semibold text-on-surface" />
                </div>
            </div>

            <div class="p-3 bg-surface-container-low rounded-xl border border-outline-variant">
                <span class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant block mb-2">Hitos Reproductivos Proyectados</span>
                <div class="grid grid-cols-3 gap-2 text-center text-xs">
                    <div class="p-2 rounded-lg bg-surface-container-lowest border border-outline-variant/60">
                        <span class="text-[10px] text-outline block">Ecografía (+28d)</span>
                        <strong class="font-mono text-primary" id="label-eco">--</strong>
                    </div>
                    <div class="p-2 rounded-lg bg-surface-container-lowest border border-outline-variant/60">
                        <span class="text-[10px] text-outline block">Maternidad (+107d)</span>
                        <strong class="font-mono text-secondary" id="label-traslado">--</strong>
                    </div>
                    <div class="p-2 rounded-lg bg-surface-container-lowest border border-outline-variant/60">
                        <span class="text-[10px] text-outline block">Parto Est. (+114d)</span>
                        <strong class="font-mono text-error" id="label-parto">--</strong>
                    </div>
                </div>
            </div>

            <div class="pt-3 border-t border-outline-variant flex justify-end gap-2">
                <button type="button" onclick="cerrarModalServicioIA()" class="px-4 py-2 rounded-xl border border-outline-variant text-xs font-semibold text-on-surface hover:bg-surface-container">
                    Cancelar
                </button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-primary text-on-primary text-xs font-bold hover:bg-secondary transition flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px]">save</span>
                    <span>Guardar Servicio</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: REGISTRAR PARTO -->
<div id="modal-registrar-parto" class="fixed inset-0 z-50 bg-[#1c2a1e]/45 backdrop-blur-[2px] hidden items-center justify-center p-4 overflow-y-auto">
    <div class="w-full max-w-2xl bg-surface-container-lowest rounded-2xl shadow-2xl border border-outline-variant overflow-hidden flex flex-col my-auto">
        <div class="p-5 border-b border-outline-variant bg-surface-container-low flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-teal-700 text-white flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">child_care</span>
                </div>
                <div>
                    <h3 class="font-headline font-bold text-base text-on-surface">Registrar Parto Efectivo</h3>
                    <p class="text-[11px] text-on-surface-variant">Actualiza estado a lactancia e inicia conteo de 21 días al destete</p>
                </div>
            </div>
            <button type="button" onclick="cerrarModalRegistrarParto()" class="text-on-surface-variant hover:text-on-surface">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <form method="post" asp-page-handler="RegistrarParto" class="p-5 space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-on-surface mb-1">Cerda Madre *</label>
                    <select name="cerdaId" id="parto-cerda-id" required class="w-full h-9 px-3 rounded-lg border border-outline-variant text-xs font-semibold font-mono text-on-surface">
                        @foreach (var c in Model.Data.Cerdas)
                        {
                            <option value="@c.Id">@c.Caravana (Paridad @c.Paridad · @c.Estado.Replace("_", " "))</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-on-surface mb-1">Jaula de Maternidad (BD) *</label>
                    @{
                        var jaulasMat = Model.Catalogos.Jaulas
                            .Where(j => (j.EtapaZootecnica ?? "").Contains("Maternidad", StringComparison.OrdinalIgnoreCase))
                            .ToList();
                        if (jaulasMat.Count == 0) jaulasMat = Model.Catalogos.Jaulas;
                    }
                    <select name="jaulaMaternidad" id="parto-jaula" required class="w-full h-9 px-2.5 rounded-lg border border-outline-variant text-xs font-semibold font-mono text-on-surface">
                        @if (jaulasMat.Count > 0)
                        {
                            @foreach (var j in jaulasMat)
                            {
                                <option value="@j.Codigo">@j.Codigo — @j.Nombre (@j.OcupacionActual/@j.CapacidadMaxima)</option>
                            }
                        }
                        else
                        {
                            <option value="M-01">M-01</option>
                        }
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-on-surface mb-1">Fecha y Hora del Parto *</label>
                    <input type="datetime-local" name="fechaHora" id="parto-fecha-hora" required value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" class="w-full h-9 px-3 rounded-lg border border-outline-variant text-xs font-semibold text-on-surface" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-on-surface mb-1">Duración (Minutos)</label>
                    <input type="number" name="duracionMinutos" id="parto-duracion" value="180" min="10" step="5" class="w-full h-9 px-3 rounded-lg border border-outline-variant text-xs font-mono text-on-surface" />
                </div>
            </div>

            <div class="p-3.5 bg-surface-container-low rounded-xl border border-outline-variant space-y-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-on-surface block">Conteo de la Camada</span>
                <div class="grid grid-cols-4 gap-2 text-xs">
                    <div>
                        <label class="block text-[11px] font-semibold text-teal-900 mb-1">Nacidos Vivos *</label>
                        <input type="number" name="nacidosVivos" id="parto-vivos" value="12" min="0" required oninput="calcularMetricasParto()" class="w-full h-9 px-2.5 rounded-lg border border-teal-400 bg-teal-50 text-teal-950 font-mono font-bold text-sm" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-error mb-1">Mortinatos</label>
                        <input type="number" name="nacidosMuertos" id="parto-muertos" value="0" min="0" oninput="calcularMetricasParto()" class="w-full h-9 px-2.5 rounded-lg border border-outline-variant text-on-surface font-mono font-bold text-sm" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-outline mb-1">Momias</label>
                        <input type="number" name="momias" id="parto-momias" value="0" min="0" oninput="calcularMetricasParto()" class="w-full h-9 px-2.5 rounded-lg border border-outline-variant text-on-surface font-mono font-bold text-sm" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-on-surface mb-1">Total</label>
                        <input type="number" name="totalNacidos" id="parto-total" value="12" readonly class="w-full h-9 px-2.5 rounded-lg border border-outline-variant bg-surface-container text-on-surface font-mono font-bold text-sm" />
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-on-surface mb-1">Peso Total Camada (Kg) *</label>
                    <input type="number" step="0.1" min="0.1" name="pesoTotalCamadaKg" id="parto-peso-camada" value="18.0" required oninput="calcularMetricasParto()" class="w-full h-9 px-3 rounded-lg border border-outline-variant text-xs font-mono font-bold text-on-surface" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-on-surface mb-1">Peso Promedio / Lechón</label>
                    <div class="h-9 px-3 rounded-lg bg-surface-container border border-outline-variant flex items-center justify-between text-xs">
                        <strong class="font-mono text-sm text-teal-900" id="preview-peso-lechon">1.50 Kg</strong>
                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-teal-100 text-teal-800" id="preview-calibre-lechon">Óptimo (&gt;1.35 kg)</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-on-surface mb-1">Condición Corporal (1 a 5)</label>
                    <select name="condicionCorporal" class="w-full h-9 px-3 rounded-lg border border-outline-variant text-xs font-semibold text-on-surface">
                        <option value="1.0">1.0 - Muy Delgada</option>
                        <option value="2.0">2.0 - Delgada</option>
                        <option value="3.0" selected>3.0 - Óptima</option>
                        <option value="4.0">4.0 - Sobrepeso</option>
                        <option value="5.0">5.0 - Obesa</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-on-surface mb-1">Tipo de Parto / Asistencia</label>
                    <select name="asistenciaObstetrica" class="w-full h-9 px-3 rounded-lg border border-outline-variant text-xs font-semibold text-on-surface">
                        <option value="false" selected>Eutócico (Normal)</option>
                        <option value="true">Asistido (Intervención / Distocia)</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-on-surface mb-1">Observaciones Obstétricas</label>
                <input type="text" name="observaciones" placeholder="Calostro, vitalidad, número de pezones funcionales..." class="w-full h-9 px-3 rounded-lg border border-outline-variant text-xs text-on-surface" />
            </div>

            <div class="pt-3 border-t border-outline-variant flex justify-end gap-2">
                <button type="button" onclick="cerrarModalRegistrarParto()" class="px-4 py-2 rounded-xl border border-outline-variant text-xs font-semibold text-on-surface hover:bg-surface-container">
                    Cancelar
                </button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold transition flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px]">check_circle</span>
                    <span>Asentar Parto</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function cambiarTabRepro(tab) {
            document.querySelectorAll('.tab-repro-panel').forEach(p => p.classList.add('hidden'));
            const panel = document.getElementById('tab-' + tab);
            if (panel) panel.classList.remove('hidden');

            document.querySelectorAll('.tab-repro-btn').forEach(b => {
                b.classList.remove('border-primary', 'text-primary', 'bg-primary-fixed/30');
                b.classList.add('border-transparent', 'text-on-surface-variant');
            });
            const btn = document.getElementById('btn-tab-' + tab);
            if (btn) {
                btn.classList.add('border-primary', 'text-primary', 'bg-primary-fixed/30');
                btn.classList.remove('border-transparent', 'text-on-surface-variant');
            }
        }

        function filtrarPadronCerdas() {
            const q = (document.getElementById('filtro-cerda-padron')?.value || '').trim().toLowerCase();
            document.querySelectorAll('.fila-padron-cerda').forEach(tr => {
                const hay = (tr.dataset.search || '').includes(q);
                tr.style.display = hay ? '' : 'none';
            });
        }

        function calcularCicloReproductivo() {
            const el = document.getElementById('ia-fecha');
            if (!el || !el.value) return;
            const base = new Date(el.value + 'T00:00:00');
            if (isNaN(base.getTime())) return;

            const addDays = (d, days) => {
                const copy = new Date(d.getTime());
                copy.setDate(copy.getDate() + days);
                return copy.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });
            };

            document.getElementById('label-eco').innerText = addDays(base, 28);
            document.getElementById('label-traslado').innerText = addDays(base, 107);
            document.getElementById('label-parto').innerText = addDays(base, 114);
        }

        function abrirModalServicioIA(caravana) {
            const modal = document.getElementById('modal-registrar-servicio');
            if (!modal) return;
            if (caravana) {
                const sel = document.getElementById('ia-caravana');
                if (sel) sel.value = caravana;
            }
            calcularCicloReproductivo();
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function cerrarModalServicioIA() {
            const modal = document.getElementById('modal-registrar-servicio');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        function abrirModalRegistrarParto(cerdaId, caravana, jaula, paridad) {
            const modal = document.getElementById('modal-registrar-parto');
            if (!modal) return;
            if (cerdaId) {
                const sel = document.getElementById('parto-cerda-id');
                if (sel) sel.value = cerdaId;
            }
            if (jaula) {
                const jInput = document.getElementById('parto-jaula');
                if (jInput) jInput.value = jaula;
            }
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            calcularMetricasParto();
        }

        function cerrarModalRegistrarParto() {
            const modal = document.getElementById('modal-registrar-parto');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        function calcularMetricasParto() {
            const vivos = parseInt(document.getElementById('parto-vivos')?.value) || 0;
            const muertos = parseInt(document.getElementById('parto-muertos')?.value) || 0;
            const momias = parseInt(document.getElementById('parto-momias')?.value) || 0;
            const pesoCamada = parseFloat(document.getElementById('parto-peso-camada')?.value) || 0;

            const totalEl = document.getElementById('parto-total');
            if (totalEl) totalEl.value = vivos + muertos + momias;

            const prom = vivos > 0 ? (pesoCamada / vivos) : 0;
            const prevPeso = document.getElementById('preview-peso-lechon');
            const prevCal = document.getElementById('preview-calibre-lechon');
            if (prevPeso) prevPeso.innerText = prom.toFixed(2) + ' Kg';
            if (prevCal) {
                if (prom >= 1.35) {
                    prevCal.innerText = 'Óptimo (>1.35 kg)';
                    prevCal.className = 'text-[10px] font-bold px-1.5 py-0.5 rounded bg-teal-100 text-teal-800';
                } else if (prom >= 1.15) {
                    prevCal.innerText = 'Aceptable (1.15–1.35 kg)';
                    prevCal.className = 'text-[10px] font-bold px-1.5 py-0.5 rounded bg-amber-100 text-amber-900';
                } else {
                    prevCal.innerText = 'Bajo Peso (<1.15 kg)';
                    prevCal.className = 'text-[10px] font-bold px-1.5 py-0.5 rounded bg-red-100 text-red-800';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            calcularCicloReproductivo();
        });
    </script>
}
