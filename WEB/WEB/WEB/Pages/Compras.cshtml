@page
@model WEB.Pages.ComprasModel
@inject WEB.Services.UserRoleService RoleService
@{
    var verCostos = RoleService.EsAdmin;
    ViewData["Title"] = verCostos ? "Compras, Proveedores & Catálogo - AgroPig Suite" : "Catálogo & Requisiciones Técnicas - AgroPig Suite";
}

<div class="flex flex-col gap-6">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-outline-variant pb-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-primary uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-[16px]">shopping_cart</span>
                <span>@(verCostos ? "Abastecimiento & Logística Agropecuaria" : "Abastecimiento Clínico & Sanitario")</span>
            </div>
            <h1 class="text-2xl font-headline font-bold text-on-surface flex items-center gap-2.5">
                <span>@(verCostos ? "Catálogo de Productos & Órdenes de Compra" : "Catálogo Técnico & Requisiciones de Farmacia")</span>
                <span class="text-xs px-2.5 py-0.5 rounded-full @(verCostos ? "bg-emerald-100 text-emerald-800 border border-emerald-300" : "bg-teal-100 text-teal-800 border border-teal-300") font-bold">
                    @(verCostos ? "Bimonetario $ USD / C$ NIO" : "Vista Clínica (Sin Costos)")
                </span>
            </h1>
            <p class="text-xs text-on-surface-variant mt-1">
                @(verCostos
                    ? "Gestión comercial de proveedores, lista de precios mayoristas con reglas de descuento por volumen (porcentaje o monto fijo) y emisión de órdenes vinculadas a inventario."
                    : "Consulta de proveedores homologados, catálogo técnico de insumos veterinarios y emisión o recepción física de requisiciones hacia Kardex.")
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2.5">
            @if (verCostos)
            {
                <button type="button" onclick="abrirModalNuevoProducto()" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-surface-container-high text-on-surface hover:bg-surface-container-highest text-xs font-bold transition-all border border-outline-variant shadow-xs">
                    <span class="material-symbols-outlined text-[16px]">add_box</span>
                    <span>+ Producto a Catálogo</span>
                </button>
                <button type="button" onclick="abrirModalNuevoProveedor()" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-surface-container-high text-on-surface hover:bg-surface-container-highest text-xs font-bold transition-all border border-outline-variant shadow-xs">
                    <span class="material-symbols-outlined text-[16px]">business</span>
                    <span>+ Nuevo Proveedor</span>
                </button>
            }
            <a href="#seccion-nueva-orden" onclick="cambiarTab('nueva-orden')" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-primary text-on-primary hover:bg-primary/90 text-xs font-bold transition-all shadow-sm">
                <span class="material-symbols-outlined text-[16px]">receipt_long</span>
                <span>@(verCostos ? "Crear Orden de Compra" : "Nueva Requisición")</span>
            </a>
        </div>
    </div>

    <!-- Alert / Toast Messages -->
    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center gap-2.5 shadow-xs">
            <span class="material-symbols-outlined text-emerald-600 text-[20px]">check_circle</span>
            <span>@Model.MensajeExito</span>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-800 text-xs font-semibold flex items-center gap-2.5 shadow-xs">
            <span class="material-symbols-outlined text-red-600 text-[20px]">error</span>
            <span>@Model.MensajeError</span>
        </div>
    }

    <!-- KPI Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        @if (verCostos)
        {
            <!-- KPI 1: Inversión en Compras -->
            <div class="p-4 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col justify-between">
                <div class="flex items-center justify-between text-on-surface-variant text-xs">
                    <span class="font-bold uppercase tracking-wider text-outline">Total en Órdenes</span>
                    <span class="material-symbols-outlined text-emerald-600">payments</span>
                </div>
                <div class="mt-2">
                    <div class="text-2xl font-bold font-headline text-emerald-800">
                        $@Model.Data.TotalCompradoUsd.ToString("N2") <span class="text-xs font-normal text-on-surface-variant">USD</span>
                    </div>
                    <div class="text-xs font-semibold text-emerald-700 mt-0.5">
                        C$ @Model.Data.TotalCompradoNio.ToString("N2") <span class="text-[10px] text-outline font-normal">(TC: @Model.Data.TasaCambioOficial)</span>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-t border-outline-variant/60 flex items-center justify-between text-[11px] text-on-surface-variant">
                    <span>Órdenes emitidas activas</span>
                    <span class="font-bold text-on-surface">@Model.Data.OrdenesCompra.Count</span>
                </div>
            </div>
        }
        else
        {
            <div class="p-4 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col justify-between">
                <div class="flex items-center justify-between text-on-surface-variant text-xs">
                    <span class="font-bold uppercase tracking-wider text-outline">Requisiciones Registradas</span>
                    <span class="material-symbols-outlined text-teal-700">receipt_long</span>
                </div>
                <div class="mt-2">
                    <div class="text-2xl font-bold font-headline text-teal-800">
                        @Model.Data.OrdenesCompra.Count <span class="text-xs font-normal text-on-surface-variant">órdenes</span>
                    </div>
                    <div class="text-xs font-medium text-on-surface-variant mt-0.5">
                        Solicitudes de insumos y biológicos
                    </div>
                </div>
                <div class="mt-3 pt-2 border-t border-outline-variant/60 flex items-center justify-between text-[11px] text-on-surface-variant">
                    <span>En tránsito a Kardex</span>
                    <span class="font-bold text-on-surface">@Model.Data.TotalOrdenesPendientes</span>
                </div>
            </div>
        }

        <!-- KPI 2: Proveedores Homologados -->
        <div class="p-4 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-on-surface-variant text-xs">
                <span class="font-bold uppercase tracking-wider text-outline">Proveedores Activos</span>
                <span class="material-symbols-outlined text-primary">storefront</span>
            </div>
            <div class="mt-2">
                <div class="text-2xl font-bold font-headline text-primary">
                    @Model.Data.TotalProveedoresActivos <span class="text-xs font-normal text-on-surface-variant">empresas</span>
                </div>
                <div class="text-xs font-medium text-on-surface-variant mt-0.5">
                    Nutrición, Salud y Equipamiento
                </div>
            </div>
            <div class="mt-3 pt-2 border-t border-outline-variant/60 flex items-center justify-between text-[11px] text-on-surface-variant">
                <span>RUC &amp; crédito verificado</span>
                <span class="font-bold text-emerald-700">100% formal</span>
            </div>
        </div>

        <!-- KPI 3: Catálogo de Insumos -->
        <div class="p-4 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-on-surface-variant text-xs">
                <span class="font-bold uppercase tracking-wider text-outline">Productos en Catálogo</span>
                <span class="material-symbols-outlined text-amber-700">inventory_2</span>
            </div>
            <div class="mt-2">
                <div class="text-2xl font-bold font-headline text-on-surface">
                    @Model.Data.TotalProductosCatalogo <span class="text-xs font-normal text-on-surface-variant">artículos</span>
                </div>
                <div class="text-xs font-medium text-on-surface-variant mt-0.5">
                    Alimentos, biológicos y ferretería
                </div>
            </div>
            <div class="mt-3 pt-2 border-t border-outline-variant/60 flex items-center justify-between text-[11px] text-on-surface-variant">
                <span>Con reglas de descuento</span>
                <span class="font-bold text-primary">@Model.Data.ProductosCatalogo.Count(p => p.AplicaDescuento) artículos</span>
            </div>
        </div>

        <!-- KPI 4: Órdenes Pendientes -->
        <div class="p-4 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-on-surface-variant text-xs">
                <span class="font-bold uppercase tracking-wider text-outline">Pendientes de Recepción</span>
                <span class="material-symbols-outlined text-blue-600">local_shipping</span>
            </div>
            <div class="mt-2">
                <div class="text-2xl font-bold font-headline text-blue-800">
                    @Model.Data.TotalOrdenesPendientes <span class="text-xs font-normal text-on-surface-variant">en tránsito</span>
                </div>
                <div class="text-xs font-medium text-on-surface-variant mt-0.5">
                    Por ingresar formalmente a Kardex
                </div>
            </div>
            <div class="mt-3 pt-2 border-t border-outline-variant/60 flex items-center justify-between text-[11px] text-on-surface-variant">
                <span>Recepción en un clic</span>
                <span class="font-bold text-blue-700">Auto-Kardex</span>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-outline-variant gap-2 overflow-x-auto">
        <button type="button" onclick="cambiarTab('catalogo')" id="tab-btn-catalogo" class="px-4 py-2.5 text-xs font-bold border-b-2 border-primary text-primary flex items-center gap-2 transition-all">
            <span class="material-symbols-outlined text-[16px]">menu_book</span>
            <span>Catálogo &amp; Precios Mayoristas</span>
            <span class="px-1.5 py-0.2 rounded-full bg-primary/10 text-primary text-[10px]">@Model.Data.ProductosCatalogo.Count</span>
        </button>
        <button type="button" onclick="cambiarTab('nueva-orden')" id="tab-btn-nueva-orden" class="px-4 py-2.5 text-xs font-bold border-b-2 border-transparent text-on-surface-variant hover:text-on-surface flex items-center gap-2 transition-all">
            <span class="material-symbols-outlined text-[16px]">add_shopping_cart</span>
            <span>Emitir Nueva Orden de Compra</span>
        </button>
        <button type="button" onclick="cambiarTab('ordenes')" id="tab-btn-ordenes" class="px-4 py-2.5 text-xs font-bold border-b-2 border-transparent text-on-surface-variant hover:text-on-surface flex items-center gap-2 transition-all">
            <span class="material-symbols-outlined text-[16px]">receipt</span>
            <span>Historial de Órdenes</span>
            <span class="px-1.5 py-0.2 rounded-full bg-surface-container-high text-on-surface text-[10px]">@Model.Data.OrdenesCompra.Count</span>
        </button>
        <button type="button" onclick="cambiarTab('proveedores')" id="tab-btn-proveedores" class="px-4 py-2.5 text-xs font-bold border-b-2 border-transparent text-on-surface-variant hover:text-on-surface flex items-center gap-2 transition-all">
            <span class="material-symbols-outlined text-[16px]">contacts</span>
            <span>Directorio de Proveedores</span>
            <span class="px-1.5 py-0.2 rounded-full bg-surface-container-high text-on-surface text-[10px]">@Model.Data.Proveedores.Count</span>
        </button>
    </div>

    <!-- TAB 1: CATÁLOGO DE PRODUCTOS & PRECIOS CON REGLAS DE DESCUENTO -->
    <div id="tab-panel-catalogo" class="flex flex-col gap-4">
        @if (verCostos)
        {
            <!-- Information Box on Discount Rules -->
            <div class="p-3.5 rounded-xl border border-primary/20 bg-primary-fixed/20 flex flex-col md:flex-row md:items-center justify-between gap-3 text-xs">
                <div class="flex items-start gap-2.5">
                    <span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5">percent</span>
                    <div>
                        <span class="font-bold text-on-surface">Política de Descuentos por Volumen Configurable:</span>
                        <p class="text-on-surface-variant mt-0.5">
                            Cada producto puede tener un umbral de activación (ej. a partir de 10 sacos o 20 quintales). El descuento puede calcularse como <strong>porcentaje (%)</strong> sobre el precio o como <strong>rebaja monetaria fija ($ USD / C$ NIO)</strong> por unidad.
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    <span class="px-2.5 py-1 rounded-md bg-white border border-outline-variant font-bold text-primary text-[11px]">
                        Tasa Oficial: C$ 36.80 = $1.00 USD
                    </span>
                </div>
            </div>
        }

        <!-- Filter bar -->
        <div class="p-3 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-outline uppercase tracking-wider">Filtrar por Proveedor:</span>
                <select id="filtro-catalogo-proveedor" onchange="filtrarCatalogo()" class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-outline-variant bg-surface text-on-surface focus:ring-1 focus:ring-primary">
                    <option value="">Todos los proveedores (@Model.Data.Proveedores.Count)</option>
                    @foreach (var prv in Model.Data.Proveedores)
                    {
                        <option value="@prv.Id">@prv.NombreComercial</option>
                    }
                </select>
            </div>
            <div class="text-xs text-on-surface-variant">
                Mostrando <strong id="contador-productos" class="text-primary font-bold">@Model.Data.ProductosCatalogo.Count</strong> productos homologados
            </div>
        </div>

        <!-- Products Grid / Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="grid-productos-catalogo">
            @foreach (var prod in Model.Data.ProductosCatalogo)
            {
                <div class="producto-card p-4 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs hover:shadow-md transition-all flex flex-col justify-between" data-proveedor-id="@prod.ProveedorId">
                    <div>
                        <!-- Header & Supplier Badge -->
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-md bg-surface-container-high text-on-surface-variant border border-outline-variant">
                                    <span class="material-symbols-outlined text-[12px]">store</span>
                                    @prod.ProveedorNombre
                                </span>
                                <div class="text-[11px] font-mono text-outline mt-1 font-semibold">@prod.CodigoProducto</div>
                            </div>
                            @if (verCostos)
                            {
                                @if (prod.AplicaDescuento)
                                {
                                    <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full @(prod.TipoDescuento == "porcentaje" ? "bg-purple-100 text-purple-800 border border-purple-300" : "bg-emerald-100 text-emerald-800 border border-emerald-300")">
                                        <span class="material-symbols-outlined text-[11px]">local_offer</span>
                                        @(prod.TipoDescuento == "porcentaje" ? $"{prod.DescuentoPorcentaje:0.#}% Dto." : $"-$ {prod.DescuentoMonetarioUsd:N2}")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-surface-container text-outline">
                                        Precio Neto
                                    </span>
                                }
                            }
                        </div>

                        <!-- Product Title -->
                        <h2 class="text-sm font-bold text-on-surface mt-2.5 leading-snug">@prod.NombreProducto</h2>
                        <div class="text-xs text-on-surface-variant mt-0.5">Presentación: <strong>@prod.UnidadMedida</strong></div>

                        @if (verCostos)
                        {
                            <!-- Pricing Box -->
                            <div class="mt-3 p-2.5 rounded-lg bg-surface-container-low border border-outline-variant/60 flex items-center justify-between">
                                <div>
                                    <div class="text-[10px] text-outline font-semibold uppercase">Precio Regular</div>
                                    <div class="text-base font-bold text-primary font-headline">$@prod.PrecioUnitarioUsd.ToString("N2") <span class="text-[10px] font-normal text-on-surface-variant">USD / @prod.UnidadMedida</span></div>
                                </div>
                                <div class="text-right">
                                    <div class="text-[10px] text-outline font-semibold uppercase">En Córdobas</div>
                                    <div class="text-xs font-bold text-on-surface">C$ @prod.PrecioUnitarioNio.ToString("N2")</div>
                                </div>
                            </div>

                            <!-- Discount Rule Detail -->
                            @if (prod.AplicaDescuento)
                            {
                                <div class="mt-2.5 p-2 rounded-lg bg-emerald-50/70 border border-emerald-200 text-emerald-900 text-xs flex flex-col gap-1">
                                    <div class="flex items-center gap-1 font-bold text-[11px]">
                                        <span class="material-symbols-outlined text-[14px] text-emerald-700">verified</span>
                                        <span>Regla de Descuento por Volumen:</span>
                                    </div>
                                    <div class="text-[11px] leading-tight">
                                        A partir de <strong>@prod.UnidadesMinimasDescuento @prod.UnidadMedida</strong>:
                                        @if (prod.TipoDescuento == "porcentaje")
                                        {
                                            <span>aplica <strong>@prod.DescuentoPorcentaje:0.#% de descuento</strong> (Ahorro: $@(Math.Round(prod.PrecioUnitarioUsd * (prod.DescuentoPorcentaje / 100m), 2).ToString("N2")) USD / ud).</span>
                                        }
                                        else
                                        {
                                            <span>descuento monetario directo de <strong>$@prod.DescuentoMonetarioUsd.ToString("N2") USD</strong> (C$ @prod.DescuentoMonetarioNio.ToString("N2")) por unidad.</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(prod.NotasPromocion))
                                    {
                                        <div class="text-[10px] text-emerald-700 italic">“@prod.NotasPromocion”</div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <!-- Action to add to purchase order -->
                    <div class="mt-4 pt-3 border-t border-outline-variant/60 flex items-center justify-between">
                        <span class="text-[11px] text-outline">Disponible para órdenes</span>
                        <button type="button" onclick="agregarAOrdenDirecta('@prod.Id', '@prod.ProveedorId')" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-primary/10 hover:bg-primary text-primary hover:text-white text-xs font-bold transition-all">
                            <span class="material-symbols-outlined text-[14px]">add_shopping_cart</span>
                            <span>Pedir Insumo</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- TAB 2: EMITIR NUEVA ORDEN DE COMPRA (REACTIVA CON DESCUENTOS EN VIVO) -->
    <div id="tab-panel-nueva-orden" class="hidden flex flex-col gap-5">
        <div class="p-5 rounded-2xl border border-outline-variant bg-surface-container-lowest shadow-sm flex flex-col gap-5">
            <div>
                <h2 class="text-base font-headline font-bold text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">post_add</span>
                    <span>Formulario de Emisión de Orden de Compra</span>
                </h2>
                <p class="text-xs text-on-surface-variant mt-0.5">
                    Selecciona el proveedor y los productos. Ingresa las cantidades y el motor calculará en tiempo real si calificas para descuentos por volumen.
                </p>
            </div>

            <!-- Header Parameters -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-4 rounded-xl bg-surface-container-low border border-outline-variant/80">
                <div>
                    <label for="orden-proveedor-select" class="block text-xs font-bold text-on-surface mb-1">Proveedor Comercial *</label>
                    <select id="orden-proveedor-select" onchange="alCambiarProveedorOrden()" class="w-full text-xs font-semibold px-3 py-2 rounded-lg border border-outline-variant bg-white text-on-surface focus:ring-2 focus:ring-primary">
                        <option value="">-- Seleccionar Proveedor --</option>
                        @foreach (var prv in Model.Data.Proveedores)
                        {
                            <option value="@prv.Id" data-pago="@prv.CondicionesPago" data-contacto="@prv.ContactoNombre">@prv.NombreComercial (@prv.CondicionesPago)</option>
                        }
                    </select>
                </div>
                @if (verCostos)
                {
                    <div>
                        <label for="orden-moneda-select" class="block text-xs font-bold text-on-surface mb-1">Moneda Principal</label>
                        <select id="orden-moneda-select" class="w-full text-xs font-semibold px-3 py-2 rounded-lg border border-outline-variant bg-white text-on-surface focus:ring-2 focus:ring-primary">
                            <option value="USD" selected>Dólares Americanos ($ USD)</option>
                            <option value="NIO">Córdobas Nicaragüenses (C$ NIO)</option>
                        </select>
                    </div>
                }
                else
                {
                    <input type="hidden" id="orden-moneda-select" value="USD" />
                }
                <div>
                    <label for="orden-fecha-entrega" class="block text-xs font-bold text-on-surface mb-1">Fecha Entrega Esperada</label>
                    <input id="orden-fecha-entrega" type="date" value="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")" class="w-full text-xs font-semibold px-3 py-2 rounded-lg border border-outline-variant bg-white text-on-surface focus:ring-2 focus:ring-primary" />
                </div>
            </div>

            <!-- Line Items Table -->
            <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-on-surface uppercase tracking-wider">Productos Seleccionados para la Orden</span>
                    <span id="orden-proveedor-aviso" class="text-xs text-outline italic">Selecciona un proveedor arriba para cargar sus productos disponibles.</span>
                </div>

                <div class="overflow-x-auto rounded-xl border border-outline-variant">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-surface-container-high text-on-surface font-bold border-b border-outline-variant">
                                <th class="p-3">Producto / Presentación</th>
                                @if (verCostos)
                                {
                                    <th class="p-3 text-center">Precio Lista ($)</th>
                                    <th class="p-3 text-center">Regla de Descuento</th>
                                }
                                <th class="p-3 text-center w-28">Cantidad</th>
                                @if (verCostos)
                                {
                                    <th class="p-3 text-right">Subtotal ($)</th>
                                    <th class="p-3 text-right">Descuento ($)</th>
                                    <th class="p-3 text-right">Total Neto ($)</th>
                                }
                                <th class="p-3 text-center w-12">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="orden-lineas-tbody">
                            <tr id="orden-empty-row">
                                <td colspan="@(verCostos ? 8 : 3)" class="p-8 text-center text-on-surface-variant">
                                    <span class="material-symbols-outlined text-[36px] text-outline block mb-1">add_shopping_cart</span>
                                    <span>No hay productos agregados a la orden. Selecciona un proveedor y pulsa "Agregar Producto".</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="flex items-center justify-between pt-2">
                    <button type="button" id="btn-agregar-linea" onclick="abrirSelectorProductoParaOrden()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-primary font-bold text-xs border border-outline-variant transition-all">
                        <span class="material-symbols-outlined text-[16px]">add</span>
                        <span>+ Agregar Producto de Proveedor</span>
                    </button>
                    <div class="text-xs text-outline italic">
                        Los descuentos se aplican automáticamente al alcanzar las unidades mínimas exigidas por el proveedor.
                    </div>
                </div>
            </div>

            <!-- Observations & Financial Summary Box -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-outline-variant">
                <div class="md:col-span-2">
                    <label for="orden-observaciones" class="block text-xs font-bold text-on-surface mb-1">Observaciones / Instrucciones de Entrega</label>
                    <textarea id="orden-observaciones" rows="3" placeholder="Ej: Entregar en Galpón 1, descargar en plataforma de tolvas. Horario de recepción: 08:00 a 12:00." class="w-full text-xs px-3 py-2 rounded-lg border border-outline-variant bg-white text-on-surface focus:ring-2 focus:ring-primary"></textarea>
                </div>

                <!-- Financial calculation panel -->
                <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant flex flex-col gap-2">
                    @if (verCostos)
                    {
                        <div class="flex items-center justify-between text-xs text-on-surface-variant">
                            <span>Subtotal Bruto:</span>
                            <span id="resumen-subtotal-usd" class="font-bold text-on-surface">$ 0.00 USD</span>
                        </div>
                        <div class="flex items-center justify-between text-xs text-emerald-700">
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">local_offer</span>
                                Descuento por Volumen:
                            </span>
                            <span id="resumen-descuento-usd" class="font-bold">-$ 0.00 USD</span>
                        </div>
                        <div class="pt-2 border-t border-outline-variant/80 flex items-center justify-between">
                            <span class="text-xs font-bold text-on-surface">TOTAL ORDEN:</span>
                            <div class="text-right">
                                <div id="resumen-total-usd" class="text-lg font-headline font-bold text-primary">$ 0.00 USD</div>
                                <div id="resumen-total-nio" class="text-xs font-bold text-on-surface-variant">C$ 0.00 NIO</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-xs text-on-surface-variant">
                            Las cantidades solicitadas serán cotizadas y autorizadas por Administración al emitir la compra.
                        </div>
                    }

                    <div class="mt-2">
                        <button type="button" id="btn-emitir-orden-submit" onclick="enviarOrdenCompra()" class="w-full py-2.5 px-4 rounded-xl bg-primary text-on-primary hover:bg-primary/90 font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition-all">
                            <span class="material-symbols-outlined text-[16px]">send</span>
                            <span>Emitir Orden de Compra</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 3: HISTORIAL DE ÓRDENES DE COMPRA -->
    <div id="tab-panel-ordenes" class="hidden flex flex-col gap-4">
        @if (!Model.Data.OrdenesCompra.Any())
        {
            <div class="p-12 text-center rounded-2xl border border-outline-variant bg-surface-container-lowest text-on-surface-variant">
                <span class="material-symbols-outlined text-[48px] text-outline mb-2">receipt_long</span>
                <p class="font-bold text-base text-on-surface">No se han emitido órdenes de compra aún.</p>
                <p class="text-xs text-outline mt-1">Usa la pestaña "Emitir Nueva Orden de Compra" para generar la primera.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-surface-container-high text-on-surface font-bold border-b border-outline-variant">
                            <th class="p-3">N° Orden</th>
                            <th class="p-3">Proveedor</th>
                            <th class="p-3">Fecha Emisión</th>
                            <th class="p-3">Estado</th>
                            @if (verCostos)
                            {
                                <th class="p-3 text-right">Subtotal</th>
                                <th class="p-3 text-right">Descuento</th>
                                <th class="p-3 text-right">Total ($ USD)</th>
                                <th class="p-3 text-right">Total (C$ NIO)</th>
                            }
                            <th class="p-3 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/60">
                        @foreach (var ord in Model.Data.OrdenesCompra)
                        {
                            <tr class="hover:bg-surface-container-low/50 transition-colors">
                                <td class="p-3 font-mono font-bold text-primary">
                                    @ord.NumeroOrden
                                    <div class="text-[10px] text-outline font-normal">@ord.CantidadItems ítems</div>
                                </td>
                                <td class="p-3 font-semibold text-on-surface">
                                    @ord.ProveedorNombre
                                    @if (!string.IsNullOrWhiteSpace(ord.Observaciones))
                                    {
                                        <div class="text-[10px] text-on-surface-variant truncate max-w-xs">@ord.Observaciones</div>
                                    }
                                </td>
                                <td class="p-3 text-on-surface-variant">
                                    @ord.FechaEmision.ToString("dd/MM/yyyy")
                                    @if (ord.FechaEntregaEsperada.HasValue)
                                    {
                                        <div class="text-[10px] text-outline">Entr.: @ord.FechaEntregaEsperada.Value.ToString("dd/MM/yyyy")</div>
                                    }
                                </td>
                                <td class="p-3">
                                    <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full border @ord.EstadoBadgeClass">
                                        <span class="material-symbols-outlined text-[12px]">@(ord.Estado == "recibida_kardex" ? "check_circle" : "local_shipping")</span>
                                        @ord.EstadoTexto
                                    </span>
                                    @if (ord.Estado == "recibida_kardex" && !string.IsNullOrWhiteSpace(ord.LoteFabricante))
                                    {
                                        <div class="mt-1 text-[10px] text-emerald-800 font-semibold flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[12px]">verified</span>
                                            <span>Lote: @ord.LoteFabricante</span>
                                            @if (ord.FechaVencimiento.HasValue)
                                            {
                                                <span>(Vence: @ord.FechaVencimiento.Value.ToString("dd/MM/yy"))</span>
                                            }
                                        </div>
                                    }
                                </td>
                                @if (verCostos)
                                {
                                    <td class="p-3 text-right font-medium text-on-surface-variant">$@ord.SubtotalUsd.ToString("N2")</td>
                                    <td class="p-3 text-right font-bold text-emerald-700">
                                        @(ord.DescuentoUsd > 0 ? $"-${ord.DescuentoUsd:N2}" : "$0.00")
                                    </td>
                                    <td class="p-3 text-right font-bold font-headline text-on-surface">$@ord.TotalUsd.ToString("N2")</td>
                                    <td class="p-3 text-right font-bold text-primary">C$ @ord.TotalNio.ToString("N2")</td>
                                }
                                <td class="p-3 text-center">
                                    <div class="flex items-center justify-center gap-1.5">
                                        <button type="button" onclick="abrirModalImprimirOrden('@ord.Id')" class="px-2 py-1 rounded bg-surface-container hover:bg-surface-container-high text-primary font-bold text-[11px] border border-outline-variant flex items-center gap-1" title="Ver proforma, imprimir PDF o enviar por WhatsApp">
                                            <span class="material-symbols-outlined text-[13px]">print</span>
                                            <span>Factura / PDF</span>
                                        </button>
                                        @if (ord.Estado != "recibida_kardex")
                                        {
                                            <button type="button" onclick="abrirModalRecibirKardex('@ord.Id', '@ord.NumeroOrden')" class="px-2.5 py-1 rounded bg-emerald-700 hover:bg-emerald-800 text-white text-[11px] font-bold flex items-center gap-1 shadow-xs" title="Ingresar físicamente con Lote y Vencimiento a Kardex">
                                                <span class="material-symbols-outlined text-[13px]">inventory_2</span>
                                                <span>Recibir Kardex</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- TAB 4: DIRECTORIO DE PROVEEDORES -->
    <div id="tab-panel-proveedores" class="hidden flex flex-col gap-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var prv in Model.Data.Proveedores)
            {
                <div class="p-4 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col justify-between">
                    <div>
                        <div class="flex items-start justify-between">
                            <span class="text-xs font-mono font-bold text-outline">@prv.Codigo</span>
                            <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300">
                                @prv.CondicionesPago
                            </span>
                        </div>
                        <h2 class="text-base font-bold text-on-surface mt-2">@prv.NombreComercial</h2>
                        @if (!string.IsNullOrWhiteSpace(prv.RazonSocial))
                        {
                            <div class="text-xs text-on-surface-variant font-medium">@prv.RazonSocial</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(prv.Ruc))
                        {
                            <div class="text-[11px] text-outline mt-0.5">RUC: @prv.Ruc</div>
                        }

                        <div class="mt-3 pt-3 border-t border-outline-variant/60 flex flex-col gap-1.5 text-xs text-on-surface-variant">
                            @if (!string.IsNullOrWhiteSpace(prv.ContactoNombre))
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[15px] text-outline">person</span>
                                    <span>Contacto: <strong class="text-on-surface">@prv.ContactoNombre</strong></span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(prv.Telefono))
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[15px] text-outline">phone</span>
                                    <span>@prv.Telefono</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(prv.Email))
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[15px] text-outline">mail</span>
                                    <span>@prv.Email</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(prv.Direccion))
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[15px] text-outline">pin_drop</span>
                                    <span class="truncate">@prv.Direccion</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-outline-variant/60 flex items-center justify-between text-xs">
                        <span class="text-outline font-semibold">@prv.TotalProductosOfrecidos productos en catálogo</span>
                        <button type="button" onclick="filtrarCatalogoPorProveedorYVer('@prv.Id')" class="text-primary hover:underline font-bold flex items-center gap-1">
                            <span>Ver Insumos</span>
                            <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODALES: NUEVO PROVEEDOR, NUEVO PRODUCTO Y DETALLE DE ORDEN -->
<!-- ========================================================================= -->

<!-- Modal: Nuevo Proveedor -->
<div id="modal-nuevo-proveedor" class="fixed inset-0 bg-black/50 z-50 items-center justify-center p-4" style="display: none;">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl max-w-lg w-full p-6 shadow-xl flex flex-col gap-4">
        <div class="flex items-center justify-between border-b border-outline-variant pb-3">
            <h2 class="text-base font-bold font-headline text-on-surface flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">add_business</span>
                <span>Registrar Nuevo Proveedor</span>
            </h2>
            <button type="button" onclick="cerrarModalNuevoProveedor()" class="text-outline hover:text-on-surface">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form method="post" asp-page-handler="GuardarProveedor" class="flex flex-col gap-3 text-xs">
            <div>
                <label class="block font-bold text-on-surface mb-1">Nombre Comercial *</label>
                <input type="text" name="NombreComercial" required placeholder="Ej: Nutrición Animal S.A." class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-on-surface mb-1">Razón Social</label>
                    <input type="text" name="RazonSocial" placeholder="Nombre legal" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface" />
                </div>
                <div>
                    <label class="block font-bold text-on-surface mb-1">RUC</label>
                    <input type="text" name="Ruc" placeholder="J031000000000" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-on-surface mb-1">Contacto Principal</label>
                    <input type="text" name="ContactoNombre" placeholder="Ing. o Lic. encargado" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface" />
                </div>
                <div>
                    <label class="block font-bold text-on-surface mb-1">Teléfono</label>
                    <input type="text" name="Telefono" placeholder="+505 8888-0000" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-on-surface mb-1">Correo Electrónico</label>
                    <input type="email" name="Email" placeholder="ventas@proveedor.com" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface" />
                </div>
                <div>
                    <label class="block font-bold text-on-surface mb-1">Condiciones de Pago</label>
                    <select name="CondicionesPago" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface font-semibold">
                        <option value="Contado">Contado</option>
                        <option value="Crédito 15 días">Crédito 15 días</option>
                        <option value="Crédito 30 días">Crédito 30 días</option>
                        <option value="Crédito 45 días">Crédito 45 días</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="block font-bold text-on-surface mb-1">Dirección Física</label>
                <input type="text" name="Direccion" placeholder="Dirección o Km carretera" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface" />
            </div>
            <div class="flex items-center justify-end gap-2 pt-3 border-t border-outline-variant">
                <button type="button" onclick="cerrarModalNuevoProveedor()" class="px-3 py-2 rounded-lg border border-outline-variant font-bold text-on-surface hover:bg-surface-container">Cancelar</button>
                <button type="submit" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-bold hover:bg-primary/90">Guardar Proveedor</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Nuevo Producto al Catálogo con Reglas de Descuento -->
<div id="modal-nuevo-producto" class="fixed inset-0 bg-black/50 z-50 items-center justify-center p-4" style="display: none;">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl max-w-lg w-full p-6 shadow-xl flex flex-col gap-4">
        <div class="flex items-center justify-between border-b border-outline-variant pb-3">
            <h2 class="text-base font-bold font-headline text-on-surface flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">add_box</span>
                <span>Agregar Producto &amp; Regla de Descuento</span>
            </h2>
            <button type="button" onclick="cerrarModalNuevoProducto()" class="text-outline hover:text-on-surface">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form method="post" asp-page-handler="GuardarProducto" class="flex flex-col gap-3 text-xs">
            <div>
                <label class="block font-bold text-on-surface mb-1">Proveedor Distribuidor *</label>
                <select name="ProveedorId" required class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface font-semibold">
                    <option value="">-- Seleccionar --</option>
                    @foreach (var prv in Model.Data.Proveedores)
                    {
                        <option value="@prv.Id">@prv.NombreComercial</option>
                    }
                </select>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-on-surface mb-1">Código / SKU</label>
                    <input type="text" name="CodigoProducto" placeholder="ALIM-ENG-02" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface" />
                </div>
                <div>
                    <label class="block font-bold text-on-surface mb-1">Unidad de Medida *</label>
                    <input type="text" name="UnidadMedida" value="qq (100 lbs)" required class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface font-semibold" />
                </div>
            </div>
            <div>
                <label class="block font-bold text-on-surface mb-1">Nombre Comercial del Producto *</label>
                <input type="text" name="NombreProducto" required placeholder="Ej: Concentrado Cerdas Gestantes Fibra Alta" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface font-semibold" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-on-surface mb-1">Precio Unitario ($ USD) *</label>
                    <input type="number" step="0.01" min="0.01" name="PrecioUnitarioUsd" id="modal-precio-usd" oninput="sincronizarModalPrecios('usd')" required placeholder="32.50" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface font-bold text-primary" />
                </div>
                <div>
                    <label class="block font-bold text-on-surface mb-1">Precio Unitario (C$ NIO)</label>
                    <input type="number" step="0.01" min="0.01" name="PrecioUnitarioNio" id="modal-precio-nio" oninput="sincronizarModalPrecios('nio')" placeholder="1196.00" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-surface text-on-surface font-bold" />
                </div>
            </div>

            <!-- Sección de Descuento por Volumen -->
            <div class="p-3.5 rounded-xl border border-primary/30 bg-primary-fixed/15 flex flex-col gap-2.5">
                <div class="flex items-center justify-between">
                    <label class="flex items-center gap-2 cursor-pointer font-bold text-on-surface">
                        <input type="checkbox" name="AplicaDescuento" id="chk-aplica-descuento" value="true" onchange="toggleSeccionDescuentoModal()" class="w-4 h-4 rounded text-primary border-outline-variant" />
                        <span>¿Aplica descuento por volumen o compras al mayor?</span>
                    </label>
                </div>

                <div id="seccion-descuento-inputs" class="hidden flex flex-col gap-2.5 pt-2 border-t border-primary/20">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-bold text-on-surface mb-1">A partir de cuántas unidades:</label>
                            <input type="number" name="UnidadesMinimasDescuento" value="10" min="1" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-white text-on-surface font-bold" />
                        </div>
                        <div>
                            <label class="block font-bold text-on-surface mb-1">Tipo de Descuento:</label>
                            <select name="TipoDescuento" id="modal-tipo-descuento" onchange="actualizarTipoDescuentoModal()" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-white text-on-surface font-bold">
                                <option value="porcentaje">Porcentaje (%)</option>
                                <option value="monetario">Monto Fijo ($ / C$)</option>
                            </select>
                        </div>
                    </div>

                    <div id="campo-dto-porcentaje" class="grid grid-cols-1 gap-2">
                        <label class="block font-bold text-on-surface mb-0.5">Porcentaje de Descuento (%):</label>
                        <input type="number" step="0.1" min="0" max="100" name="DescuentoPorcentaje" value="8.0" placeholder="Ej: 8.0%" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-white text-on-surface font-bold text-purple-700" />
                    </div>

                    <div id="campo-dto-monetario" class="hidden grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-bold text-on-surface mb-0.5">Rebaja por unidad ($ USD):</label>
                            <input type="number" step="0.01" min="0" name="DescuentoMonetarioUsd" value="0.00" placeholder="2.50" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-white text-on-surface font-bold text-emerald-700" />
                        </div>
                        <div>
                            <label class="block font-bold text-on-surface mb-0.5">Rebaja por unidad (C$ NIO):</label>
                            <input type="number" step="0.01" min="0" name="DescuentoMonetarioNio" value="0.00" placeholder="92.00" class="w-full px-3 py-2 rounded-lg border border-outline-variant bg-white text-on-surface font-bold text-emerald-700" />
                        </div>
                    </div>

                    <div>
                        <label class="block font-bold text-on-surface mb-0.5">Nota o condición de la promoción:</label>
                        <input type="text" name="NotasPromocion" placeholder="Ej: 8% de descuento por compra de 20 quintales o más" class="w-full px-3 py-1.5 rounded-lg border border-outline-variant bg-white text-on-surface" />
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-outline-variant">
                <button type="button" onclick="cerrarModalNuevoProducto()" class="px-3 py-2 rounded-lg border border-outline-variant font-bold text-on-surface hover:bg-surface-container">Cancelar</button>
                <button type="submit" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-bold hover:bg-primary/90">Guardar en Catálogo</button>
            </div>
        </form>
    </div>
</div>

<style>
@@media print {
    body * {
        visibility: hidden !important;
    }
    #modal-imprimir-orden, #modal-imprimir-orden * {
        visibility: visible !important;
    }
    #seccion-factura-imprimible, #seccion-factura-imprimible * {
        visibility: visible !important;
    }
    #modal-imprimir-orden {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
