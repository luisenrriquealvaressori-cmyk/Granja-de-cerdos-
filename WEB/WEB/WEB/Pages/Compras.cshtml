<!-- Scripts interactivos de Catálogo y Órdenes -->
<script>
    const VER_COSTOS_COMPRAS = @(verCostos ? "true" : "false");
    const CATALOGO_JSON = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Data.ProductosCatalogo));
    const ORDENES_JSON = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Data.OrdenesCompra));
    const PROVEEDORES_JSON = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Data.Proveedores));
    const TASA_CAMBIO = 36.80;

    let lineasOrden = [];
    let ordenActualFactura = null;

    function cambiarTab(tab) {
        ['catalogo', 'nueva-orden', 'ordenes', 'proveedores'].forEach(t => {
            const panel = document.getElementById('tab-panel-' + t);
            const btn = document.getElementById('tab-btn-' + t);
            if (panel) panel.classList.toggle('hidden', t !== tab);
            if (btn) {
                if (t === tab) {
                    btn.classList.add('border-primary', 'text-primary');
                    btn.classList.remove('border-transparent', 'text-on-surface-variant');
                } else {
                    btn.classList.remove('border-primary', 'text-primary');
                    btn.classList.add('border-transparent', 'text-on-surface-variant');
                }
            }
        });
    }

    function filtrarCatalogo() {
        const provId = document.getElementById('filtro-catalogo-proveedor').value;
        const cards = document.querySelectorAll('.producto-card');
        let visibles = 0;
        cards.forEach(c => {
            const match = !provId || c.getAttribute('data-proveedor-id') === provId;
            c.style.display = match ? 'flex' : 'none';
            if (match) visibles++;
        });
        document.getElementById('contador-productos').textContent = visibles;
    }

    function filtrarCatalogoPorProveedorYVer(provId) {
        document.getElementById('filtro-catalogo-proveedor').value = provId;
        filtrarCatalogo();
        cambiarTab('catalogo');
    }

    function alCambiarProveedorOrden() {
        const provId = document.getElementById('orden-proveedor-select').value;
        const aviso = document.getElementById('orden-proveedor-aviso');
        if (provId) {
            const sel = document.getElementById('orden-proveedor-select');
            const texto = sel.options[sel.selectedIndex].text;
            aviso.textContent = 'Proveedor seleccionado: ' + texto;
            aviso.className = 'text-xs text-primary font-bold';
        } else {
            aviso.textContent = 'Selecciona un proveedor arriba para cargar sus productos disponibles.';
            aviso.className = 'text-xs text-outline italic';
        }
        // Limpiar líneas si cambió de proveedor
        lineasOrden = [];
        renderizarLineasOrden();
    }

    function abrirSelectorProductoParaOrden() {
        const provId = document.getElementById('orden-proveedor-select').value;
        if (!provId) {
            alert('Por favor selecciona primero un proveedor en la parte superior.');
            document.getElementById('orden-proveedor-select').focus();
            return;
        }

        const prodsProveedor = CATALOGO_JSON.filter(p => p.ProveedorId === provId);
        if (prodsProveedor.length === 0) {
            alert('Este proveedor no tiene productos registrados en el catálogo aún.');
            return;
        }

        // Agregar el primer producto disponible que no esté ya en la lista
        const yaAgregados = new Set(lineasOrden.map(l => l.ProductoCatalogoId));
        const disponible = prodsProveedor.find(p => !yaAgregados.has(p.Id)) || prodsProveedor[0];

        lineasOrden.push({
            ProductoCatalogoId: disponible.Id,
            Cantidad: disponible.UnidadesMinimasDescuento || 10
        });

        renderizarLineasOrden();
    }

    function agregarAOrdenDirecta(prodId, provId) {
        document.getElementById('orden-proveedor-select').value = provId;
        alCambiarProveedorOrden();
        const prod = CATALOGO_JSON.find(p => p.Id === prodId);
        lineasOrden = [{
            ProductoCatalogoId: prodId,
            Cantidad: prod ? (prod.UnidadesMinimasDescuento || 10) : 10
        }];
        renderizarLineasOrden();
        cambiarTab('nueva-orden');
        window.scrollTo({ top: 300, behavior: 'smooth' });
    }

    function renderizarLineasOrden() {
        const tbody = document.getElementById('orden-lineas-tbody');
        const provId = document.getElementById('orden-proveedor-select').value;
        const prodsProveedor = CATALOGO_JSON.filter(p => p.ProveedorId === provId);

        if (lineasOrden.length === 0) {
            tbody.innerHTML = `
                <tr id="orden-empty-row">
                    <td colspan="${VER_COSTOS_COMPRAS ? 8 : 3}" class="p-8 text-center text-on-surface-variant">
                        <span class="material-symbols-outlined text-[36px] text-outline block mb-1">add_shopping_cart</span>
                        <span>No hay productos agregados a la orden. Selecciona un proveedor y pulsa "Agregar Producto".</span>
                    </td>
                </tr>`;
            actualizarTotalesOrden();
            return;
        }

        let html = '';
        lineasOrden.forEach((linea, index) => {
            const prod = CATALOGO_JSON.find(p => p.Id === linea.ProductoCatalogoId) || prodsProveedor[0];
            if (!prod) return;

            // Calcular cálculos reactivos
            const cant = Number(linea.Cantidad) || 0;
            const subtotal = cant * prod.PrecioUnitarioUsd;
            let descuentoUnit = 0;
            let aplicoDesc = false;

            if (prod.AplicaDescuento && cant >= prod.UnidadesMinimasDescuento) {
                aplicoDesc = true;
                if (prod.TipoDescuento === 'porcentaje') {
                    descuentoUnit = prod.PrecioUnitarioUsd * (prod.DescuentoPorcentaje / 100);
                } else {
                    descuentoUnit = prod.DescuentoMonetarioUsd > 0 ? prod.DescuentoMonetarioUsd : (prod.DescuentoMonetarioNio / TASA_CAMBIO);
                }
            }

            const descuentoLinea = cant * descuentoUnit;
            const totalLinea = Math.max(0, subtotal - descuentoLinea);

            // Opciones de productos del proveedor
            let optionsHtml = '';
            prodsProveedor.forEach(p => {
                const sel = p.Id === linea.ProductoCatalogoId ? 'selected' : '';
                optionsHtml += `<option value="${p.Id}" ${sel}>${p.NombreProducto} (${p.UnidadMedida})</option>`;
            });

            const costoCols = VER_COSTOS_COMPRAS ? `
                    <td class="p-3 text-center font-bold text-on-surface font-headline">
                        $${prod.PrecioUnitarioUsd.toFixed(2)}
                    </td>
                    <td class="p-3 text-center">
                        ${prod.AplicaDescuento 
                            ? `<span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-md ${aplicoDesc ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-surface-container text-outline'}">
                                ${prod.TipoDescuento === 'porcentaje' ? `${prod.DescuentoPorcentaje}% dto.` : `-$${prod.DescuentoMonetarioUsd.toFixed(2)}`} (min ${prod.UnidadesMinimasDescuento} uds)
                               </span>`
                            : `<span class="text-[10px] text-outline">Sin dto.</span>`
                        }
                    </td>` : '';
            const costoTotalsCols = VER_COSTOS_COMPRAS ? `
                    <td class="p-3 text-right font-medium text-on-surface-variant">
                        $${subtotal.toFixed(2)}
                    </td>
                    <td class="p-3 text-right font-bold ${aplicoDesc ? 'text-emerald-700' : 'text-outline'}">
                        ${aplicoDesc ? `-$${descuentoLinea.toFixed(2)}` : '$0.00'}
                    </td>
                    <td class="p-3 text-right font-bold text-primary font-headline">
                        $${totalLinea.toFixed(2)}
                    </td>` : '';

            html += `
                <tr class="border-b border-outline-variant/60 hover:bg-surface-container-low/40 transition-colors">
                    <td class="p-3">
                        <select onchange="cambiarProductoLinea(${index}, this.value)" class="w-full text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-outline-variant bg-white text-on-surface">
                            ${optionsHtml}
                        </select>
                        <div class="text-[11px] text-outline mt-0.5">${prod.UnidadMedida}</div>
                    </td>
                    ${costoCols}
                    <td class="p-3 text-center">
                        <input type="number" min="1" value="${cant}" oninput="cambiarCantidadLinea(${index}, this.value)" class="w-20 text-center font-bold text-xs px-2 py-1 rounded border border-outline-variant bg-white text-on-surface focus:ring-1 focus:ring-primary" />
                    </td>
                    ${costoTotalsCols}
                    <td class="p-3 text-center">
                        <button type="button" onclick="eliminarLineaOrden(${index})" class="p-1 rounded text-red-600 hover:bg-red-50">
                            <span class="material-symbols-outlined text-[16px]">delete</span>
                        </button>
                    </td>
                </tr>`;
        });

        tbody.innerHTML = html;
        actualizarTotalesOrden();
    }

    function cambiarProductoLinea(index, nuevoProdId) {
        lineasOrden[index].ProductoCatalogoId = nuevoProdId;
        renderizarLineasOrden();
    }

    function cambiarCantidadLinea(index, nuevaCant) {
        lineasOrden[index].Cantidad = Number(nuevaCant) || 0;
        renderizarLineasOrden();
    }

    function eliminarLineaOrden(index) {
        lineasOrden.splice(index, 1);
        renderizarLineasOrden();
    }

    function actualizarTotalesOrden() {
        if (!VER_COSTOS_COMPRAS) return;
        let subtotalUsd = 0;
        let descuentoUsd = 0;
        let totalUsd = 0;

        lineasOrden.forEach(l => {
            const prod = CATALOGO_JSON.find(p => p.Id === l.ProductoCatalogoId);
            if (!prod) return;
            const cant = Number(l.Cantidad) || 0;
            const sub = cant * prod.PrecioUnitarioUsd;
            let desc = 0;

            if (prod.AplicaDescuento && cant >= prod.UnidadesMinimasDescuento) {
                if (prod.TipoDescuento === 'porcentaje') {
                    desc = cant * (prod.PrecioUnitarioUsd * (prod.DescuentoPorcentaje / 100));
                } else {
                    const unitDesc = prod.DescuentoMonetarioUsd > 0 ? prod.DescuentoMonetarioUsd : (prod.DescuentoMonetarioNio / TASA_CAMBIO);
                    desc = cant * unitDesc;
                }
            }

            subtotalUsd += sub;
            descuentoUsd += desc;
            totalUsd += Math.max(0, sub - desc);
        });

        const totalNio = totalUsd * TASA_CAMBIO;

        document.getElementById('resumen-subtotal-usd').textContent = '$ ' + subtotalUsd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD';
        document.getElementById('resumen-descuento-usd').textContent = '-$ ' + descuentoUsd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD';
        document.getElementById('resumen-total-usd').textContent = '$ ' + totalUsd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD';
        document.getElementById('resumen-total-nio').textContent = 'C$ ' + totalNio.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' NIO';
    }

    async function enviarOrdenCompra() {
        const provId = document.getElementById('orden-proveedor-select').value;
        if (!provId) {
            alert('Debes seleccionar un proveedor.');
            return;
        }

        if (lineasOrden.length === 0 || !lineasOrden.some(l => l.Cantidad > 0)) {
            alert('Debes agregar al menos un producto con cantidad mayor a cero.');
            return;
        }

        const moneda = document.getElementById('orden-moneda-select').value;
        const fechaEntrega = document.getElementById('orden-fecha-entrega').value || null;
        const observaciones = document.getElementById('orden-observaciones').value;

        const payload = {
            ProveedorId: provId,
            Moneda: moneda,
            FechaEntregaEsperada: fechaEntrega,
            Observaciones: observaciones,
            Lineas: lineasOrden.map(l => ({
                ProductoCatalogoId: l.ProductoCatalogoId,
                Cantidad: l.Cantidad
            }))
        };

        const btn = document.getElementById('btn-emitir-orden-submit');
        btn.disabled = true;
        btn.innerHTML = `<span class="material-symbols-outlined text-[16px] animate-spin">refresh</span><span>Procesando...</span>`;

        try {
            const resp = await fetch('?handler=EmitirOrden', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify(payload)
            });

            const data = await resp.json();
            if (data.exito) {
                alert(data.mensaje);
                window.location.href = '/Compras?tab=ordenes';
            } else {
                alert('Atención: ' + data.mensaje);
                btn.disabled = false;
                btn.innerHTML = `<span class="material-symbols-outlined text-[16px]">send</span><span>Emitir Orden de Compra</span>`;
            }
        } catch (e) {
            alert('Error de comunicación: ' + e);
            btn.disabled = false;
            btn.innerHTML = `<span class="material-symbols-outlined text-[16px]">send</span><span>Emitir Orden de Compra</span>`;
        }
    }

    // Modal Helpers
    function abrirModalNuevoProveedor() {
        document.getElementById('modal-nuevo-proveedor').style.display = 'flex';
    }
    function cerrarModalNuevoProveedor() {
        document.getElementById('modal-nuevo-proveedor').style.display = 'none';
    }
    function abrirModalNuevoProducto() {
        document.getElementById('modal-nuevo-producto').style.display = 'flex';
    }
    function cerrarModalNuevoProducto() {
        document.getElementById('modal-nuevo-producto').style.display = 'none';
    }

    function toggleSeccionDescuentoModal() {
        const chk = document.getElementById('chk-aplica-descuento').checked;
        const seccion = document.getElementById('seccion-descuento-inputs');
        seccion.classList.toggle('hidden', !chk);
    }

    function actualizarTipoDescuentoModal() {
        const tipo = document.getElementById('modal-tipo-descuento').value;
        document.getElementById('campo-dto-porcentaje').classList.toggle('hidden', tipo !== 'porcentaje');
        document.getElementById('campo-dto-monetario').classList.toggle('hidden', tipo !== 'monetario');
    }

    function sincronizarModalPrecios(origen) {
        if (origen === 'usd') {
            const usd = parseFloat(document.getElementById('modal-precio-usd').value) || 0;
            document.getElementById('modal-precio-nio').value = (usd * TASA_CAMBIO).toFixed(2);
        } else {
            const nio = parseFloat(document.getElementById('modal-precio-nio').value) || 0;
            document.getElementById('modal-precio-usd').value = (nio / TASA_CAMBIO).toFixed(2);
        }
    }

    // Modal Recepción Kardex con Lote y Vencimiento
    function abrirModalRecibirKardex(id, num) {
        document.getElementById('recibir-orden-id').value = id;
        document.getElementById('recibir-orden-numero').textContent = num;
        document.getElementById('modal-recibir-kardex').style.display = 'flex';
    }
    function cerrarModalRecibirKardex() {
        document.getElementById('modal-recibir-kardex').style.display = 'none';
    }

    // Modal Imprimir Orden / Factura / WhatsApp
    function abrirModalImprimirOrden(ordId) {
        const ord = ORDENES_JSON.find(o => o.Id === ordId);
        if (!ord) {
            alert('Orden no encontrada en los registros.');
            return;
        }
        ordenActualFactura = ord;

        document.getElementById('factura-numero-orden').textContent = ord.NumeroOrden;
        document.getElementById('factura-fecha-emision').textContent = 'Fecha: ' + (ord.FechaEmision ? new Date(ord.FechaEmision).toLocaleDateString('es-NI') : 'Hoy');
        document.getElementById('factura-badge-estado').textContent = ord.EstadoTexto || ord.Estado;
        document.getElementById('factura-proveedor-nombre').textContent = ord.ProveedorNombre;
        
        const prov = PROVEEDORES_JSON.find(p => p.Id === ord.ProveedorId);
        if (prov) {
            document.getElementById('factura-proveedor-contacto').textContent = 'Contacto: ' + (prov.ContactoNombre || 'Oficina Comercial') + ' (Tel: ' + (prov.Telefono || 'N/A') + ')';
            document.getElementById('factura-proveedor-condiciones').textContent = 'Condición: ' + (prov.CondicionesPago || 'Contado') + ' | RUC: ' + (prov.Ruc || 'N/A');
            document.getElementById('factura-firma-proveedor').textContent = prov.NombreComercial;
        } else {
            document.getElementById('factura-proveedor-contacto').textContent = 'Proveedor Autorizado';
            document.getElementById('factura-proveedor-condiciones').textContent = 'Condición de Pago Acordada';
            document.getElementById('factura-firma-proveedor').textContent = ord.ProveedorNombre;
        }

        document.getElementById('factura-fecha-entrega').textContent = 'Entrega Estimada: ' + (ord.FechaEntregaEsperada ? new Date(ord.FechaEntregaEsperada).toLocaleDateString('es-NI') : 'Inmediata');
        document.getElementById('factura-solicitado-por').textContent = 'Solicitado por: ' + (ord.SolicitadoPor || 'Luis (Admin)');
        document.getElementById('factura-firma-elaborado').textContent = ord.SolicitadoPor || 'Luis (Admin)';
        document.getElementById('factura-observaciones').textContent = ord.Observaciones || 'Sin instrucciones adicionales de entrega.';

        // Llenar tabla de ítems
        const tbody = document.getElementById('factura-items-tbody');
        tbody.innerHTML = '';
        if (ord.Detalles && ord.Detalles.length > 0) {
            ord.Detalles.forEach(d => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-gray-50';
                const colsCostos = VER_COSTOS_COMPRAS ? `
                    <td class="py-2 text-right font-medium">$${Number(d.PrecioUnitarioUsd).toFixed(2)}</td>
                    <td class="py-2 text-right ${d.AplicoDescuento ? 'text-emerald-700 font-bold' : 'text-gray-400'}">
                        ${d.AplicoDescuento ? '-$' + Number(d.MontoDescuentoLineaUsd).toFixed(2) : '$0.00'}
                    </td>
                    <td class="py-2 text-right text-gray-600">$${Number(d.SubtotalLineaUsd).toFixed(2)}</td>
                    <td class="py-2 text-right font-bold text-gray-900">$${Number(d.TotalLineaUsd).toFixed(2)}</td>
                    <td class="py-2 text-right font-bold text-emerald-800">C$ ${Number(d.TotalLineaNio).toFixed(2)}</td>` : '';
                tr.innerHTML = `
                    <td class="py-2 font-medium">${d.Descripcion}</td>
                    <td class="py-2 text-center text-gray-500">${d.UnidadMedida}</td>
                    <td class="py-2 text-right font-bold">${Number(d.Cantidad).toFixed(0)}</td>
                    ${colsCostos}
                `;
                tbody.appendChild(tr);
            });
        } else {
            tbody.innerHTML = `
                <tr>
                    <td colspan="${VER_COSTOS_COMPRAS ? 8 : 3}" class="py-4 text-center text-gray-500 italic">No hay ítems detallados para esta orden.</td>
                </tr>`;
        }

        if (VER_COSTOS_COMPRAS) {
            document.getElementById('factura-subtotal-usd').textContent = '$ ' + Number(ord.SubtotalUsd).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('factura-descuento-usd').textContent = '-$ ' + Number(ord.DescuentoUsd).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('factura-total-usd').textContent = '$ ' + Number(ord.TotalUsd).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD';
            document.getElementById('factura-total-nio').textContent = 'C$ ' + Number(ord.TotalNio).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' NIO';
        }

        document.getElementById('modal-imprimir-orden').style.display = 'flex';
    }

    function cerrarModalImprimirOrden() {
        document.getElementById('modal-imprimir-orden').style.display = 'none';
        ordenActualFactura = null;
    }

    function imprimirOrdenActual() {
        window.print();
    }

    function enviarOrdenPorWhatsApp() {
        if (!ordenActualFactura) return;
        const ord = ordenActualFactura;
        const prov = PROVEEDORES_JSON.find(p => p.Id === ord.ProveedorId);
        const tel = prov && prov.Telefono ? prov.Telefono.replace(/[^0-9]/g, '') : '';
        
        let texto = `*${VER_COSTOS_COMPRAS ? 'ORDEN DE COMPRA OFICIAL' : 'REQUISICIÓN TÉCNICA DE INSUMOS'} - AGROPIG SUITE*%0A`;
        texto += `*N° Orden:* ${ord.NumeroOrden}%0A`;
        texto += `*Proveedor:* ${ord.ProveedorNombre}%0A`;
        texto += `*Fecha:* ${new Date(ord.FechaEmision).toLocaleDateString('es-NI')}%0A`;
        if (VER_COSTOS_COMPRAS) {
            texto += `*Total:* $${Number(ord.TotalUsd).toFixed(2)} USD (C$ ${Number(ord.TotalNio).toFixed(2)} NIO)%0A`;
            if (ord.DescuentoUsd > 0) {
                texto += `*Descuento por volumen aplicado:* -$${Number(ord.DescuentoUsd).toFixed(2)} USD%0A`;
            }
        }
        texto += `%0A*Detalle de Insumos:*%0A`;
        if (ord.Detalles && ord.Detalles.length > 0) {
            ord.Detalles.forEach(d => {
                const costoTxt = VER_COSTOS_COMPRAS ? ` ($${Number(d.TotalLineaUsd).toFixed(2)} USD)` : '';
                texto += `• ${d.Cantidad} ${d.UnidadMedida} - ${d.Descripcion}${costoTxt}%0A`;
            });
        }
        texto += `%0A*Observaciones:* ${ord.Observaciones || 'Entrega estándar en granja.'}%0A`;
        texto += `*Solicitado por:* ${ord.SolicitadoPor || 'Administración Granja San Jerónimo'}`;

        const url = tel ? `https://api.whatsapp.com/send?phone=${tel}&text=${texto}` : `https://api.whatsapp.com/send?text=${texto}`;
        window.open(url, '_blank');
    }

    // Activar tab inicial desde URL
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const tab = urlParams.get('tab') || 'catalogo';
        cambiarTab(tab);
    });
</script>
