@page
@model WEB.Pages.CerdosModel
@inject WEB.Services.UserRoleService RoleService
@{
    ViewData["Title"] = "Padrón de Cerdos, Jaulas & Planes Zootécnicos";
    var user = RoleService.CurrentUser;
    var jaulasJson = System.Text.Json.JsonSerializer.Serialize(Model.Data.Jaulas);
    var cerdosJson = System.Text.Json.JsonSerializer.Serialize(Model.Data.Cerdos);
}

<div class="px-6 py-5 flex flex-col gap-6">

    <!-- Mensajes de Notificación TempData -->
    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-900 flex items-center justify-between shadow-xs animate-fade-in">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-emerald-600 text-2xl">verified</span>
                <div>
                    <div class="text-xs font-bold uppercase tracking-wider text-emerald-700">Operación Exitosa</div>
                    <div class="text-sm font-medium">@Model.MensajeExito</div>
                </div>
            </div>
            <button type="button" class="text-emerald-700 hover:text-emerald-900" onclick="this.parentElement.remove()">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="p-4 rounded-xl bg-red-50 border border-red-300 text-red-900 flex items-center justify-between shadow-xs animate-fade-in">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-red-600 text-2xl">error</span>
                <div>
                    <div class="text-xs font-bold uppercase tracking-wider text-red-700">Aviso / Error</div>
                    <div class="text-sm font-medium">@Model.MensajeError</div>
                </div>
            </div>
            <button type="button" class="text-red-700 hover:text-red-900" onclick="this.parentElement.remove()">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }

    <!-- 1. HEADER & ACCIONES PRINCIPALES -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-outline-variant pb-4">
        <div>
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-28px">grid_view</span>
                <h1 class="text-2xl font-headline font-bold text-on-surface tracking-tight">Padrón de Cerdos, Jaulas &amp; Nutrición</h1>
            </div>
            <p class="text-xs text-on-surface-variant mt-1">
                Control individual de piara, monitor de capacidad de jaulas/corrales por etapa y cálculo automatizado de días de vida, plan vacunal y racionamiento diario.
            </p>
        </div>

        <div class="flex items-center gap-3 flex-wrap">
            <button type="button" onclick="abrirModalCalculadora()" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-xs font-bold hover:bg-surface-container-low transition-all shadow-xs">
                <span class="material-symbols-outlined text-18px text-primary">calculate</span>
                <span>Calculadora Zootécnica</span>
            </button>
            <button type="button" onclick="abrirModalCerdo()" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-on-primary text-xs font-bold hover:bg-secondary active:scale-98 transition-all shadow-sm">
                <span class="material-symbols-outlined text-18px">add</span>
                <span>Registrar Cerdo</span>
            </button>
        </div>
    </div>

    <!-- 2. RESUMEN DE CAPACIDAD & PADRÓN POR ETAPA (KPIs) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <!-- KPI Total Cerdos -->
        <div class="p-3.5 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-on-surface-variant">
                <span class="text-11px font-bold uppercase tracking-wider">Total Piara</span>
                <span class="material-symbols-outlined text-18px text-primary">pets</span>
            </div>
            <div class="mt-2 flex items-baseline gap-1.5">
                <span class="text-2xl font-headline font-bold text-on-surface tabular-nums">@Model.Data.TotalCerdos</span>
                <span class="text-11px text-on-surface-variant">cabezas</span>
            </div>
            <div class="text-10px text-outline mt-1">Cerdos identificados</div>
        </div>

        <!-- KPI Ocupación Jaulas -->
        <div class="p-3.5 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-on-surface-variant">
                <span class="text-11px font-bold uppercase tracking-wider">Ocupación Jaulas</span>
                <span class="material-symbols-outlined text-18px text-teal-700">fence</span>
            </div>
            <div class="mt-2 flex items-baseline gap-1.5">
                <span class="text-2xl font-headline font-bold text-on-surface tabular-nums">@Model.Data.PctOcupacionGlobal%</span>
                <span class="text-11px text-on-surface-variant">(@Model.Data.TotalOcupacionJaulas/@Model.Data.TotalCapacidadJaulas)</span>
            </div>
            <div class="w-full bg-surface-container rounded-full h-1.5 mt-1.5 overflow-hidden">
                <div class="bg-teal-600 h-1.5 rounded-full" style="width: @Math.Min(100, Model.Data.PctOcupacionGlobal)%"></div>
            </div>
        </div>

        <!-- KPI Maternidad -->
        <div class="p-3.5 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-on-surface-variant">
                <span class="text-11px font-bold uppercase tracking-wider">Maternidad</span>
                <span class="material-symbols-outlined text-18px text-pink-700">child_care</span>
            </div>
            <div class="mt-2 flex items-baseline gap-1.5">
                <span class="text-2xl font-headline font-bold text-on-surface tabular-nums">@Model.Data.CerdosLactancia</span>
                <span class="text-11px text-on-surface-variant">lactantes</span>
            </div>
            <div class="text-10px text-pink-700 font-semibold mt-1">0 - 28 días | 5 tomas/d</div>
        </div>

        <!-- KPI Precebo -->
        <div class="p-3.5 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-on-surface-variant">
                <span class="text-11px font-bold uppercase tracking-wider">Precebo</span>
                <span class="material-symbols-outlined text-18px text-amber-700">spa</span>
            </div>
            <div class="mt-2 flex items-baseline gap-1.5">
                <span class="text-2xl font-headline font-bold text-on-surface tabular-nums">@Model.Data.CerdosPrecebo</span>
                <span class="text-11px text-on-surface-variant">lechones</span>
            </div>
            <div class="text-10px text-amber-800 font-semibold mt-1">29 - 70 días | 4 tomas/d</div>
        </div>

        <!-- KPI Crecimiento & Engorde -->
        <div class="p-3.5 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-on-surface-variant">
                <span class="text-11px font-bold uppercase tracking-wider">Crec. &amp; Engorde</span>
                <span class="material-symbols-outlined text-18px text-indigo-700">trending_up</span>
            </div>
            <div class="mt-2 flex items-baseline gap-1.5">
                <span class="text-2xl font-headline font-bold text-on-surface tabular-nums">@(Model.Data.CerdosCrecimiento + Model.Data.CerdosEngorde)</span>
                <span class="text-11px text-on-surface-variant">ceba</span>
            </div>
            <div class="text-10px text-indigo-700 font-semibold mt-1">71 - 165+ d | 3 y 2 tomas/d</div>
        </div>

        <!-- KPI Sanidad Urgente -->
        <div class="p-3.5 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between text-on-surface-variant">
                <span class="text-11px font-bold uppercase tracking-wider">Vacunas Hoy</span>
                <span class="material-symbols-outlined text-18px text-rose-700">vaccines</span>
            </div>
            <div class="mt-2 flex items-baseline gap-1.5">
                <span class="text-2xl font-headline font-bold text-on-surface tabular-nums">@Model.Data.VacunacionesUrgentesHoy</span>
                <span class="text-11px text-on-surface-variant">urgentes</span>
            </div>
            <div class="text-10px text-rose-700 font-semibold mt-1">Biológicos programados</div>
        </div>
    </div>

    <!-- 3. NAVEGACIÓN POR PESTAÑAS (TABS) -->
    <div class="border-b border-outline-variant flex items-center gap-6 text-xs font-bold">
        <button type="button" id="tab-btn-padron" onclick="cambiarTab('padron')" class="pb-3 text-primary border-b-2 border-primary flex items-center gap-2 transition-all">
            <span class="material-symbols-outlined text-18px">list_alt</span>
            <span>Padrón de Cerdos &amp; Edición (@Model.Data.TotalCerdos)</span>
        </button>
        <button type="button" id="tab-btn-jaulas" onclick="cambiarTab('jaulas')" class="pb-3 text-on-surface-variant hover:text-on-surface border-b-2 border-transparent flex items-center gap-2 transition-all">
            <span class="material-symbols-outlined text-18px">fence</span>
            <span>Radar de Jaulas &amp; Capacidad (@Model.Data.Jaulas.Count)</span>
        </button>
        <button type="button" id="tab-btn-calculadora" onclick="cambiarTab('calculadora')" class="pb-3 text-on-surface-variant hover:text-on-surface border-b-2 border-transparent flex items-center gap-2 transition-all">
            <span class="material-symbols-outlined text-18px">calculate</span>
            <span>Simulador de Edad, Vacunas &amp; Raciones</span>
        </button>
    </div>

    <!-- ========================================================================= -->
    <!-- CONTENIDO TAB 1: PADRÓN DE CERDOS & EDITOR -->
    <!-- ========================================================================= -->
    <div id="tab-content-padron" class="flex flex-col gap-4">
        <!-- Barra de Filtros y Búsqueda -->
        <form method="get" class="p-3.5 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col md:flex-row items-center justify-between gap-3">
            <div class="flex items-center gap-2 flex-wrap w-full md:w-auto">
                <span class="text-xs font-bold text-on-surface-variant">Filtrar por Etapa:</span>
                @{
                    var etapas = new[] { "Todas", "Maternidad", "Precebo", "Crecimiento", "Engorde", "Gestación" };
                }
                @foreach (var et in etapas)
                {
                    bool activa = (string.IsNullOrEmpty(Model.EtapaFiltro) && et == "Todas") || string.Equals(Model.EtapaFiltro, et, StringComparison.OrdinalIgnoreCase);
                    <a href="/Cerdos?etapa=@et&busqueda=@Model.Busqueda" class="px-3 py-1 rounded-full text-xs font-bold transition-colors @(activa ? "bg-primary text-on-primary shadow-xs" : "bg-surface-container-low text-on-surface-variant hover:bg-surface-container")">
                        @et
                    </a>
                }
            </div>

            <div class="flex items-center gap-2 w-full md:w-80">
                <div class="relative w-full">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-18px">search</span>
                    <input type="text" name="busqueda" value="@Model.Busqueda" placeholder="Buscar por crotal, RFID, jaula..." class="w-full pl-9 pr-3 py-1.5 text-xs rounded-lg border border-outline-variant bg-surface-container-lowest focus:outline-none focus:border-primary">
                </div>
                <button type="submit" class="px-3 py-1.5 bg-surface-container text-on-surface text-xs font-bold rounded-lg hover:bg-surface-container-high transition-colors">
                    Buscar
                </button>
                @if (!string.IsNullOrEmpty(Model.Busqueda) || !string.IsNullOrEmpty(Model.EtapaFiltro))
                {
                    <a href="/Cerdos" title="Limpiar filtros" class="p-1.5 text-on-surface-variant hover:text-red-700 transition-colors">
                        <span class="material-symbols-outlined text-18px">refresh</span>
                    </a>
                }
            </div>
        </form>

        <!-- Tabla de Cerdos con Clasificación de Edad, Alimento Dividido y Vacunas -->
        <div class="overflow-x-auto rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-outline-variant bg-surface-container-low/60 text-on-surface-variant font-bold">
                        <th class="p-3">Crotal / Identificación</th>
                        <th class="p-3">Sexo &amp; Genética</th>
                        <th class="p-3">F. Nacimiento &amp; Edad</th>
                        <th class="p-3">Peso &amp; Etapa</th>
                        <th class="p-3">Jaula / Ubicación</th>
                        <th class="p-3">Alimentación Diaria (Tomas)</th>
                        <th class="p-3">Próxima Vacunación</th>
                        <th class="p-3 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/60">
                    @if (!Model.Data.Cerdos.Any())
                    {
                        <tr>
                            <td colspan="8" class="p-8 text-center text-on-surface-variant">
                                <span class="material-symbols-outlined text-40px text-outline">search_off</span>
                                <div class="mt-2 font-bold text-sm">No se encontraron cerdos con los filtros seleccionados</div>
                                <div class="text-xs text-outline mt-0.5">Haga clic en "Registrar Cerdo" para incorporar uno nuevo.</div>
                            </td>
                        </tr>
                    }
                    @foreach (var cerdo in Model.Data.Cerdos)
                    {
                        <tr class="hover:bg-surface-container-low/40 transition-colors">
                            <!-- Crotal & RFID -->
                            <td class="p-3 font-semibold text-on-surface">
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">
                                        <span class="material-symbols-outlined text-16px">tag</span>
                                    </div>
                                    <div>
                                        <div class="font-bold text-on-surface">@cerdo.Crotal</div>
                                        <div class="text-10px text-on-surface-variant">@(string.IsNullOrEmpty(cerdo.Rfid) ? "Sin RFID" : cerdo.Rfid)</div>
                                    </div>
                                </div>
                            </td>

                            <!-- Sexo & Raza -->
                            <td class="p-3">
                                <div class="font-medium text-on-surface">@cerdo.Sexo</div>
                                <div class="text-10px text-on-surface-variant">@cerdo.LineaGenetica</div>
                            </td>

                            <!-- Nacimiento & Días de Vida -->
                            <td class="p-3">
                                <div class="font-bold text-on-surface tabular-nums">@cerdo.DiasVida días de nacido</div>
                                <div class="text-10px text-on-surface-variant">Nac: @cerdo.FechaNacimiento.ToString("dd/MM/yyyy")</div>
                            </td>

                            <!-- Peso & Etapa Clasificada -->
                            <td class="p-3">
                                <div class="font-bold text-on-surface tabular-nums">@cerdo.PesoActualKg.ToString("N2") kg</div>
                                <span class="inline-flex items-center gap-1 text-10px font-bold px-2 py-0.5 rounded-full mt-0.5 
                                    @(cerdo.EtapaActual.Contains("Lactancia") ? "bg-pink-100 text-pink-800 border border-pink-200" :
                                      cerdo.EtapaActual.Contains("Precebo") ? "bg-amber-100 text-amber-900 border border-amber-300" :
                                      cerdo.EtapaActual.Contains("Crecimiento") ? "bg-indigo-100 text-indigo-900 border border-indigo-200" :
                                      cerdo.EtapaActual.Contains("Engorde") ? "bg-emerald-100 text-emerald-900 border border-emerald-300" :
                                      "bg-purple-100 text-purple-900 border border-purple-200")">
                                    @cerdo.EtapaActual
                                </span>
                            </td>

                            <!-- Jaula Asignada -->
                            <td class="p-3">
                                <div class="font-bold text-primary flex items-center gap-1">
                                    <span class="material-symbols-outlined text-14px">fence</span>
                                    @cerdo.JaulaCodigo
                                </div>
                                <div class="text-10px text-on-surface-variant">@cerdo.JaulaNombre</div>
                            </td>

                            <!-- Plan de Alimentación Dividido por Tomas -->
                            <td class="p-3">
                                <div class="font-bold text-on-surface tabular-nums">
                                    @cerdo.ConsumoDiarioKg.ToString("N2") kg/día 
                                    <span class="text-primary font-bold">(@cerdo.TomasAlDia tomas de @cerdo.CantidadPorTomaGramos g)</span>
                                </div>
                                <div class="text-10px text-on-surface-variant truncate max-w-xs" title="@cerdo.AlimentoTipo - Horarios: @cerdo.HorariosSugeridos">
                                    @cerdo.AlimentoTipo | <span class="font-semibold text-outline">@cerdo.HorariosSugeridos</span>
                                </div>
                            </td>

                            <!-- Próxima Vacuna -->
                            <td class="p-3">
                                <div class="font-semibold text-on-surface truncate max-w-xs" title="@cerdo.ProximaVacunaNombre">
                                    @cerdo.ProximaVacunaNombre
                                </div>
                                <span class="inline-flex items-center gap-1 text-10px font-bold px-2 py-0.5 rounded-full mt-0.5 @cerdo.ProximaVacunaBadgeClass">
                                    <span class="material-symbols-outlined text-12px">vaccines</span>
                                    @cerdo.ProximaVacunaEstado
                                </span>
                            </td>

                            <!-- Acciones -->
                            <td class="p-3 text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    <button type="button" onclick="verFichaCerdo('@cerdo.Id')" title="Ver Ficha Zootécnica y Sanitaria" class="p-1.5 rounded-lg border border-outline-variant hover:bg-surface-container text-primary transition-colors">
                                        <span class="material-symbols-outlined text-16px">clinical_notes</span>
                                    </button>
                                    <button type="button" onclick="editarCerdo('@cerdo.Id')" title="Editar datos del cerdo" class="p-1.5 rounded-lg bg-primary/10 hover:bg-primary/20 text-primary transition-colors font-bold">
                                        <span class="material-symbols-outlined text-16px">edit</span>
                                    </button>
                                    @if (RoleService.PuedeDarBajaCerdos)
                                    {
                                        <form method="post" asp-page-handler="EliminarCerdo" onsubmit="return confirm('¿Está seguro de dar de baja el cerdo @cerdo.Crotal? Se liberará el cupo en su jaula.')" class="inline">
                                            <input type="hidden" name="id" value="@cerdo.Id" />
                                            <input type="hidden" name="crotal" value="@cerdo.Crotal" />
                                            <button type="submit" title="Dar de baja" class="p-1.5 rounded-lg border border-outline-variant hover:bg-red-50 text-red-700 transition-colors">
                                                <span class="material-symbols-outlined text-16px">delete</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- CONTENIDO TAB 2: RADAR DE JAULAS Y CAPACIDAD SEGÚN ETAPA -->
    <!-- ========================================================================= -->
    <div id="tab-content-jaulas" class="hidden flex-col gap-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 p-3.5 rounded-xl border border-outline-variant bg-surface-container-lowest">
            <div>
                <h3 class="font-headline font-bold text-sm text-on-surface">Capacidad de Jaulas y Corrales según Etapa Zootécnica</h3>
                <p class="text-xs text-on-surface-variant">Diseño estándar de galpones con 6 jaulas técnicas (5.0m fondo × 3.0m ancho = 15.0 m²). Capacidad: 15-20 lechones ó 5-6 cerdos adultos.</p>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
                <button type="button" onclick="filtrarJaulas('Todas')" class="jaula-filtro-btn px-3 py-1 rounded-full text-xs font-bold bg-primary text-on-primary">Todas</button>
                <button type="button" onclick="filtrarJaulas('Maternidad')" class="jaula-filtro-btn px-3 py-1 rounded-full text-xs font-bold bg-surface-container-low text-on-surface-variant hover:bg-surface-container">Maternidad</button>
                <button type="button" onclick="filtrarJaulas('Precebo')" class="jaula-filtro-btn px-3 py-1 rounded-full text-xs font-bold bg-surface-container-low text-on-surface-variant hover:bg-surface-container">Precebo</button>
                <button type="button" onclick="filtrarJaulas('Crecimiento')" class="jaula-filtro-btn px-3 py-1 rounded-full text-xs font-bold bg-surface-container-low text-on-surface-variant hover:bg-surface-container">Crecimiento</button>
                <button type="button" onclick="filtrarJaulas('Engorde')" class="jaula-filtro-btn px-3 py-1 rounded-full text-xs font-bold bg-surface-container-low text-on-surface-variant hover:bg-surface-container">Engorde</button>
                <button type="button" onclick="filtrarJaulas('Gestación')" class="jaula-filtro-btn px-3 py-1 rounded-full text-xs font-bold bg-surface-container-low text-on-surface-variant hover:bg-surface-container">Gestación</button>
            </div>
        </div>

        <!-- Banner de Especificación Técnica de Galpones y Jaulas -->
        <div class="p-3.5 rounded-xl bg-primary-fixed/20 border border-primary/30 flex items-start gap-3 text-xs">
            <span class="material-symbols-outlined text-primary text-[22px] shrink-0">architecture</span>
            <div class="flex flex-col gap-0.5">
                <span class="font-bold text-on-surface">Diseño Constructivo de Galpones: 6 Jaulas Técnicas por Galpón (5m × 3m = 15 m²)</span>
                <p class="text-on-surface-variant leading-relaxed">
                    Cada galpón cuenta por norma con <strong>6 jaulas técnicas</strong> de <strong>5.00 m de fondo por 3.00 m de ancho</strong> (Área total útil = 15.0 m²). 
                    Capacidad zootécnica reglamentada: <strong>15 a 20 lechones</strong> en etapa de recría / precebo (0.75 - 1.0 m²/lechon) o <strong>5 a 6 cerdos adultos</strong> en etapa de finalización / engorde (2.5 - 3.0 m²/adulto).
                </p>
            </div>
        </div>

        <!-- Grid de Jaulas / Corrales -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="grid-jaulas">
            @foreach (var j in Model.Data.Jaulas)
            {
                <div class="jaula-card p-4 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs flex flex-col justify-between gap-3 hover:border-primary/50 transition-all" data-etapa="@j.EtapaZootecnica">
                    <div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 rounded-lg bg-teal-50 text-teal-800 flex items-center justify-center font-bold">
                                    <span class="material-symbols-outlined text-18px">fence</span>
                                </div>
                                <div>
                                    <div class="font-bold text-sm text-on-surface">@j.Codigo</div>
                                    <div class="text-11px text-on-surface-variant">@j.Nombre</div>
                                </div>
                            </div>
                            <span class="inline-flex items-center gap-1 text-10px font-bold px-2 py-0.5 rounded-full border @j.EstadoBadgeClass">
                                @j.EstadoBadge
                            </span>
                        </div>

                        <!-- Barra de Capacidad -->
                        <div class="mt-3">
                            <div class="flex items-center justify-between text-xs mb-1">
                                <span class="font-medium text-on-surface-variant">Ocupación: <strong class="text-on-surface tabular-nums">@j.OcupacionActual / @j.CapacidadMaxima</strong> cabezas</span>
                                <span class="font-bold text-primary tabular-nums">@j.PorcentajeOcupacion%</span>
                            </div>
                            <div class="w-full bg-surface-container rounded-full h-2 overflow-hidden">
                                <div class="h-2 rounded-full @(j.PorcentajeOcupacion > 99 ? "bg-red-600" : j.PorcentajeOcupacion > 75 ? "bg-amber-600" : "bg-emerald-600")" 
                                     style="width: @Math.Min(100, j.PorcentajeOcupacion)%"></div>
                            </div>
                        </div>

                        <!-- Datos Técnicos y Medidas -->
                        <div class="mt-3 pt-2.5 border-t border-outline-variant/60 flex flex-col gap-1.5 text-11px">
                            <div class="flex items-center justify-between">
                                <span class="text-outline">Etapa zootécnica:</span>
                                <span class="font-bold text-on-surface">@j.EtapaZootecnica</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-outline">Dimensiones físicas:</span>
                                <span class="font-bold text-primary">@j.DimensionesTexto</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-outline">Capacidad reglamentada:</span>
                                <span class="font-semibold text-on-surface">@j.CapacidadesTexto</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-outline">Cupo disponible actual:</span>
                                <span class="font-bold text-emerald-800 tabular-nums">@j.CupoDisponible cabezas</span>
                            </div>
                            <div class="text-outline text-10px mt-0.5 truncate" title="@j.TipoInstalacion">
                                <span class="material-symbols-outlined text-12px align-middle text-primary">info</span>
                                @j.TipoInstalacion
                            </div>
                        </div>

                        <!-- Cerdos Alojados -->
                        <div class="mt-2.5">
                            <div class="text-10px uppercase font-bold text-outline tracking-wider mb-1">Cerdos en esta jaula:</div>
                            <div class="flex items-center gap-1 flex-wrap">
                                @if (j.CerdosAlojados.Any())
                                {
                                    @foreach (var crotal in j.CerdosAlojados)
                                    {
                                        <span class="inline-flex items-center gap-0.5 px-2 py-0.5 bg-surface-container text-on-surface rounded text-10px font-semibold">
                                            <span class="material-symbols-outlined text-10px text-primary">pets</span>
                                            @crotal
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-10px text-outline italic">Actualmente sin cerdos asignados</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mt-2 pt-2 border-t border-outline-variant/60 flex items-center justify-end">
                        <button type="button" onclick="asignarCerdoAJaula('@j.Id', '@j.Codigo', '@j.EtapaZootecnica')" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container hover:bg-primary hover:text-on-primary text-xs font-bold transition-colors">
                            <span class="material-symbols-outlined text-14px">add</span>
                            <span>Asignar Cerdo</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- CONTENIDO TAB 3: SIMULADOR DE EDAD, VACUNAS & ALIMENTACIÓN -->
    <!-- ========================================================================= -->
    <div id="tab-content-calculadora" class="hidden flex-col gap-6">
        <div class="p-5 rounded-xl border border-outline-variant bg-surface-container-lowest shadow-xs">
            <h3 class="font-headline font-bold text-base text-on-surface flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">calculate</span>
                <span>Motor Dinámico de Clasificación Zootécnica, Vacunal &amp; Nutricional</span>
            </h3>
            <p class="text-xs text-on-surface-variant mt-1">
                Ingrese cualquier fecha de nacimiento y peso corporal para simular la edad en días, clasificar la etapa productiva, generar el plan vacunal cronológico y calcular la ración de alimento dividida por tomas.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4 p-4 rounded-xl bg-surface-container-low border border-outline-variant/80">
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Fecha de Nacimiento del Cerdo:</label>
                    <input type="date" id="sim-fecha-nac" value="@DateTime.Today.AddDays(-35).ToString("yyyy-MM-dd")" onchange="ejecutarSimulador()" class="w-full px-3 py-2 text-xs rounded-lg border border-outline-variant bg-surface-container-lowest font-medium focus:outline-none focus:border-primary">
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Peso Actual Estimado (Kg):</label>
                    <input type="number" id="sim-peso" step="0.1" min="1.0" max="300.0" value="10.5" oninput="ejecutarSimulador()" class="w-full px-3 py-2 text-xs rounded-lg border border-outline-variant bg-surface-container-lowest font-medium focus:outline-none focus:border-primary">
                </div>
            </div>

            <!-- Resultados en Vivo del Simulador -->
            <div id="sim-resultados" class="mt-6 flex flex-col gap-5">
                <!-- Se inyecta dinámicamente con JS -->
            </div>
        </div>
    </div>

</div>

