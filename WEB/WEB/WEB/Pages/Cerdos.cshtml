<!-- MODAL: REGISTRAR / EDITAR CERDO CON CÁLCULO EN VIVO -->
<!-- ========================================================================= -->
<div id="modal-cerdo" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-xl w-full max-w-3xl max-h-[90vh] flex flex-col overflow-hidden animate-scale-up">
        <div class="px-6 py-4 border-b border-outline-variant flex items-center justify-between bg-surface-container-low/40">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-24px">pets</span>
                <div>
                    <h2 class="font-headline font-bold text-base text-on-surface" id="modal-cerdo-titulo">Registrar Nuevo Cerdo</h2>
                    <p class="text-11px text-on-surface-variant">Los días de nacido clasificarán automáticamente la etapa, alimento y vacunas.</p>
                </div>
            </div>
            <button type="button" onclick="cerrarModalCerdo()" class="text-on-surface-variant hover:text-on-surface">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form method="post" asp-page-handler="GuardarCerdo" class="flex-1 overflow-y-auto p-6 flex flex-col gap-4">
            <input type="hidden" name="Id" id="input-cerdo-id" value="" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Crotal -->
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Crotal / Arete Oficial: *</label>
                    <input type="text" name="Crotal" id="input-cerdo-crotal" required placeholder="Ej. CR-450" class="w-full px-3 py-2 text-xs rounded-lg border border-outline-variant bg-surface-container-lowest focus:outline-none focus:border-primary font-bold uppercase">
                </div>

                <!-- RFID -->
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">RFID / Microchip Electrónico:</label>
                    <input type="text" name="Rfid" id="input-cerdo-rfid" placeholder="Ej. RFID-982045" class="w-full px-3 py-2 text-xs rounded-lg border border-outline-variant bg-surface-container-lowest focus:outline-none focus:border-primary font-medium">
                </div>

                <!-- Sexo -->
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Sexo / Condición: *</label>
                    <select name="Sexo" id="input-cerdo-sexo" class="w-full px-3 py-2 text-xs rounded-lg border border-outline-variant bg-surface-container-lowest font-medium focus:outline-none focus:border-primary">
                        <option value="Hembra">Hembra</option>
                        <option value="Macho">Macho Entero</option>
                        <option value="Castrado">Macho Castrado</option>
                    </select>
                </div>

                <!-- Línea Genética -->
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Línea Genética / Raza (BD): *</label>
                    <select name="LineaGenetica" id="input-cerdo-genetica" class="w-full px-3 py-2 text-xs rounded-lg border border-outline-variant bg-surface-container-lowest font-medium focus:outline-none focus:border-primary">
                        @if (Model.Catalogos.LineasGeneticas.Count > 0)
                        {
                            @foreach (var lin in Model.Catalogos.LineasGeneticas)
                            {
                                <option value="@lin">@lin</option>
                            }
                        }
                        else
                        {
                            <option value="Topigs Norsvin 70">Topigs Norsvin TN70 (Excelente Prolificidad)</option>
                            <option value="Pietrain Belga">Pietrain Belga (Alto Rendimiento Magro)</option>
                            <option value="Duroc Talent">Duroc Talent (Calidad de Carne &amp; Vigor)</option>
                            <option value="Landrace DanBred">Landrace DanBred (Maternal Danés)</option>
                            <option value="Large White">Large White (Habilidad Materna)</option>
                            <option value="Pietrain x Duroc">Cruce Terminal Pietrain x Duroc</option>
                        }
                    </select>
                </div>

                <!-- Fecha de Nacimiento -->
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Fecha de Nacimiento: *</label>
                    <input type="date" name="FechaNacimiento" id="input-cerdo-fechanac" required value="@DateTime.Today.AddDays(-28).ToString("yyyy-MM-dd")" onchange="recalcularModalEnVivo()" class="w-full px-3 py-2 text-xs rounded-lg border border-outline-variant bg-surface-container-lowest font-bold text-primary focus:outline-none focus:border-primary">
                </div>

                <!-- Peso Actual -->
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Peso Actual (Kg): *</label>
                    <input type="number" step="0.1" min="0.5" max="350.0" name="PesoActualKg" id="input-cerdo-peso" required value="7.5" oninput="recalcularModalEnVivo()" class="w-full px-3 py-2 text-xs rounded-lg border border-outline-variant bg-surface-container-lowest font-bold focus:outline-none focus:border-primary">
                </div>

                <!-- Jaula / Corral Asignado -->
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Jaula / Corral Asignado:</label>
                    <select name="JaulaCorralId" id="input-cerdo-jaula" class="w-full px-3 py-2 text-xs rounded-lg border border-outline-variant bg-surface-container-lowest font-medium focus:outline-none focus:border-primary">
                        <option value="">-- Sin jaula asignada --</option>
                        @foreach (var j in Model.Data.Jaulas)
                        {
                            <option value="@j.Id" data-etapa="@j.EtapaZootecnica">
                                @j.Codigo - @j.Nombre (@j.EtapaZootecnica, @j.OcupacionActual/@j.CapacidadMaxima cabezas)
                            </option>
                        }
                    </select>
                </div>

                <!-- Estatus Sanitario -->
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Estatus Sanitario:</label>
                    <select name="EstatusSanitario" id="input-cerdo-sanitario" class="w-full px-3 py-2 text-xs rounded-lg border border-outline-variant bg-surface-container-lowest font-medium focus:outline-none focus:border-primary">
                        <option value="Saludable">Saludable / Óptimo</option>
                        <option value="En Tratamiento">En Tratamiento Veterinario</option>
                        <option value="Cuarentena">Aislamiento / Cuarentena</option>
                        <option value="Observación">En Observación Post-Destete</option>
                    </select>
                </div>
            </div>

            <!-- Observaciones -->
            <div>
                <label class="block text-xs font-bold text-on-surface mb-1">Observaciones / Notas Clínicas:</label>
                <input type="text" name="Observaciones" id="input-cerdo-obs" placeholder="Ej. Camada 14 lechones, vigoroso, peso al nacer 1.4kg" class="w-full px-3 py-2 text-xs rounded-lg border border-outline-variant bg-surface-container-lowest focus:outline-none focus:border-primary">
            </div>

            <!-- TARJETA REACTIVA EN VIVO EN EL MODAL -->
            <div id="modal-preview-calculo" class="p-4 rounded-xl bg-surface-container border border-outline-variant flex flex-col gap-3">
                <!-- Se actualiza dinámicamente -->
            </div>

            <!-- Footer con Botones -->
            <div class="pt-3 border-t border-outline-variant flex items-center justify-end gap-3">
                <button type="button" onclick="cerrarModalCerdo()" class="px-4 py-2 rounded-lg border border-outline-variant text-on-surface text-xs font-bold hover:bg-surface-container transition-colors">
                    Cancelar
                </button>
                <button type="submit" class="px-5 py-2 rounded-lg bg-primary text-on-primary text-xs font-bold hover:bg-secondary transition-all shadow-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-18px">save</span>
                    <span>Guardar Cerdo</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: FICHA TÉCNICA ZOOTÉCNICA COMPLETA DE UN CERDO -->
<!-- ========================================================================= -->
<div id="modal-ficha" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-xl w-full max-w-4xl max-h-[90vh] flex flex-col overflow-hidden animate-scale-up">
        <div class="px-6 py-4 border-b border-outline-variant flex items-center justify-between bg-surface-container-low/40">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-24px">clinical_notes</span>
                <div>
                    <h2 class="font-headline font-bold text-base text-on-surface" id="modal-ficha-titulo">Ficha Zootécnica &amp; Sanitaria</h2>
                    <p class="text-11px text-on-surface-variant">Trazabilidad completa, racionamiento nutricional y calendario de profilaxis biológica.</p>
                </div>
            </div>
            <button type="button" onclick="cerrarModalFicha()" class="text-on-surface-variant hover:text-on-surface">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto p-6 flex flex-col gap-5" id="modal-ficha-body">
            <!-- Se inyecta dinámicamente con JS -->
        </div>

        <div class="px-6 py-3 border-t border-outline-variant bg-surface-container-low/40 flex items-center justify-between">
            <span class="text-11px text-outline">Datos sincronizados con PostgreSQL central <strong>agropig_db</strong></span>
            <button type="button" onclick="cerrarModalFicha()" class="px-4 py-1.5 rounded-lg bg-primary text-on-primary text-xs font-bold hover:bg-secondary">
                Cerrar Ficha
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Colecciones serializadas del servidor
    const cerdosData = @Html.Raw(cerdosJson);
    const jaulasData = @Html.Raw(jaulasJson);

    // Motor de Cálculo Zootécnico en JavaScript idéntico al motor C#
    function calcularPlanZootecnicoJS(fechaNacStr, peso) {
        const fechaNac = new Date(fechaNacStr + "T00:00:00");
        const hoy = new Date();
        hoy.setHours(0,0,0,0);

        const diffTime = hoy - fechaNac;
        const diasVida = Math.max(0, Math.floor(diffTime / (1000 * 60 * 60 * 24)));

        let etapa = "";
        let subEtapa = "";
        let jaulaTipo = "";
        let rangoPeso = "";
        let alimento = "";
        let racionKg = 0.10;
        let tomas = 5;
        let horarios = "";
        let recomendacion = "";

        if (diasVida <= 28) {
            etapa = "Lactancia (Maternidad)";
            subEtapa = "Lechón Lactante";
            jaulaTipo = "Maternidad";
            rangoPeso = "1.4 - 7.0 kg";
            alimento = "Preiniciador Fase 1 (Creep Feeding Micro-pellet)";
            racionKg = 0.10;
            tomas = 5;
            horarios = "06:30, 09:30, 12:30, 15:30, 18:30";
            recomendacion = "Alimentación en platos lamedores limpios para acostumbrar el aparato digestivo previo al destete.";
        } else if (diasVida <= 45) {
            etapa = "Precebo Fase 1";
            subEtapa = "Destete Inmediato";
            jaulaTipo = "Precebo";
            rangoPeso = "7.0 - 15.0 kg";
            alimento = "Preiniciador Fase 2 (Pellet con Plasma Porcino Alta Digestibilidad)";
            racionKg = 0.50;
            tomas = 4;
            horarios = "07:00, 11:00, 15:00, 19:00";
            recomendacion = "Dividir en 4 tomas pequeñas para prevenir acidosis digestiva y diarreas de transición post-destete.";
        } else if (diasVida <= 70) {
            etapa = "Precebo Fase 2";
            subEtapa = "Iniciador / Transición";
            jaulaTipo = "Precebo";
            rangoPeso = "15.0 - 28.0 kg";
            alimento = "Iniciador Lecherón (20% Proteína Cruda)";
            racionKg = 1.10;
            tomas = 4;
            horarios = "07:00, 11:00, 15:00, 19:00";
            recomendacion = "Monitorear Ganancia Media Diaria meta (450 - 520 g/día) y flujo continuo de agua fresca (0.8 L/min).";
        } else if (diasVida <= 115) {
            etapa = "Crecimiento / Levante";
            subEtapa = "Desarrollo Muscular Magro";
            jaulaTipo = "Crecimiento";
            rangoPeso = "28.0 - 65.0 kg";
            alimento = "Crecimiento / Desarrollo (17% Proteína Cruda, FCR ~2.1)";
            racionKg = 1.95;
            tomas = 3;
            horarios = "07:00, 13:00, 18:00";
            recomendacion = "3 tomas distribuidas para maximizar absorción de aminoácidos esenciales y depósito de magro.";
        } else if (diasVida <= 165) {
            etapa = "Engorde / Acabado Final";
            subEtapa = "Terminación Peso Frigorífico";
            jaulaTipo = "Engorde";
            rangoPeso = "65.0 - 115.0+ kg";
            alimento = "Finalizador / Engorde Comercial (Alta Energía Neta)";
            racionKg = 2.80;
            tomas = 2;
            horarios = "07:30, 16:30";
            recomendacion = "2 raciones abundantes mañana y tarde. Control estricto del periodo de retiro sanitario de promotores.";
        } else {
            etapa = "Gestación / Reproductor";
            subEtapa = "Vientre Adulto en Mantenimiento";
            jaulaTipo = "Gestación";
            rangoPeso = "120.0 - 220.0 kg";
            alimento = "Gestación Controlada (Alta Fibra saciante)";
            racionKg = 2.20;
            tomas = 2;
            horarios = "07:00, 16:00";
            recomendacion = "2 tomas exactas para mantener condición corporal entre 3.0 y 3.5. Evitar sobrepeso gestacional.";
        }

        const gramosPorToma = Math.round((racionKg * 1000) / tomas);

        // Plan vacunal
        const vacunasDef = [
            { dia: 3, vac: "Hierro Dextrano 200mg + Toltrazuril 5%", enf: "Anemia ferropénica y Coccidiosis neonatal", dosis: "2.0 ml IM + 1.0 ml VO", via: "Intramuscular profunda / Oral" },
            { dia: 7, vac: "Mycoplasma hyopneumoniae Dosis 1", enf: "Neumonía Enzoótica Porcina", dosis: "2.0 ml IM", via: "Intramuscular tabla del cuello" },
            { dia: 21, vac: "Circovirus PCV2 + Mycoplasma Refuerzo", enf: "Desmedro multisistémico y Neumonía", dosis: "2.0 ml IM", via: "Intramuscular tabla del cuello" },
            { dia: 35, vac: "Peste Porcina Clásica (PPC Cepa China)", enf: "Inmunización oficial preventiva", dosis: "2.0 ml IM", via: "Intramuscular profunda" },
            { dia: 50, vac: "Erisipela Porcina + Actinobacillus (APP)", enf: "Mal Rojo y Pleuroneumonía aguda", dosis: "2.0 ml IM", via: "Intramuscular tabla del cuello" },
            { dia: 70, vac: "Desparasitación Interna y Externa", enf: "Ascaris suum, Stephanurus, Sarna", dosis: "1.0 ml / 33 kg SC", via: "Subcutánea retroauricular" },
            { dia: 90, vac: "Refuerzo Complejo Respiratorio PRDC", enf: "Complejo respiratorio porcino", dosis: "2.0 ml IM", via: "Intramuscular" },
            { dia: 150, vac: "Vacuna PLE (Parvo + Lepto + Erisipela)", enf: "Fallas reproductivas en reemplazos", dosis: "2.0 ml IM", via: "Intramuscular profunda" }
        ];

        const vacunas = vacunasDef.map(v => {
            const fechaEstimada = new Date(fechaNac.getTime() + (v.dia * 24 * 60 * 60 * 1000));
            const dif = diasVida - v.dia;
            let estado = "";
            let badge = "";
            let icono = "";

            if (dif > 3) {
                estado = "Aplicada / Histórica";
                badge = "bg-emerald-100 text-emerald-800 border border-emerald-300";
                icono = "check_circle";
            } else if (Math.abs(dif) <= 3) {
                estado = "URGENTE / Toca Hoy";
                badge = "bg-amber-100 text-amber-900 border border-amber-300 font-bold";
                icono = "notification_important";
            } else {
                const faltan = v.dia - diasVida;
                estado = `Programada (en ${faltan} d)`;
                badge = "bg-blue-100 text-blue-800 border border-blue-200";
                icono = "schedule";
            }

            return {
                dia: v.dia,
                fechaEstimada: fechaEstimada.toISOString().split("T")[0],
                vacuna: v.vac,
                enfermedad: v.enf,
                dosis: v.dosis,
                via: v.via,
                estado: estado,
                badge: badge,
                icono: icono
            };
        });

        return {
            diasVida: diasVida,
            etapa: etapa,
            subEtapa: subEtapa,
            jaulaTipo: jaulaTipo,
            rangoPeso: rangoPeso,
            alimento: alimento,
            racionKg: racionKg,
            tomas: tomas,
            gramosPorToma: gramosPorToma,
            horarios: horarios,
            recomendacion: recomendacion,
            vacunas: vacunas
        };
    }

    // Pestañas (Tabs)
    function cambiarTab(tab) {
        document.getElementById("tab-content-padron").classList.add("hidden");
        document.getElementById("tab-content-jaulas").classList.add("hidden");
        document.getElementById("tab-content-calculadora").classList.add("hidden");

        document.getElementById("tab-btn-padron").className = "pb-3 text-on-surface-variant hover:text-on-surface border-b-2 border-transparent flex items-center gap-2 transition-all";
        document.getElementById("tab-btn-jaulas").className = "pb-3 text-on-surface-variant hover:text-on-surface border-b-2 border-transparent flex items-center gap-2 transition-all";
        document.getElementById("tab-btn-calculadora").className = "pb-3 text-on-surface-variant hover:text-on-surface border-b-2 border-transparent flex items-center gap-2 transition-all";

        if (tab === 'padron') {
            document.getElementById("tab-content-padron").classList.remove("hidden");
            document.getElementById("tab-btn-padron").className = "pb-3 text-primary border-b-2 border-primary flex items-center gap-2 transition-all font-bold";
        } else if (tab === 'jaulas') {
            document.getElementById("tab-content-jaulas").classList.remove("hidden");
            document.getElementById("tab-btn-jaulas").className = "pb-3 text-primary border-b-2 border-primary flex items-center gap-2 transition-all font-bold";
        } else if (tab === 'calculadora') {
            document.getElementById("tab-content-calculadora").classList.remove("hidden");
            document.getElementById("tab-btn-calculadora").className = "pb-3 text-primary border-b-2 border-primary flex items-center gap-2 transition-all font-bold";
            ejecutarSimulador();
        }
    }

    // Filtro de Jaulas
    function filtrarJaulas(etapa) {
        const cards = document.querySelectorAll(".jaula-card");
        cards.forEach(card => {
            if (etapa === 'Todas' || card.getAttribute("data-etapa").toLowerCase().includes(etapa.toLowerCase())) {
                card.classList.remove("hidden");
            } else {
                card.classList.add("hidden");
            }
        });

        const btns = document.querySelectorAll(".jaula-filtro-btn");
        btns.forEach(btn => {
            if (btn.innerText.trim() === etapa) {
                btn.className = "jaula-filtro-btn px-3 py-1 rounded-full text-xs font-bold bg-primary text-on-primary";
            } else {
                btn.className = "jaula-filtro-btn px-3 py-1 rounded-full text-xs font-bold bg-surface-container-low text-on-surface-variant hover:bg-surface-container";
            }
        });
    }

    // Modal Cerdo
    function abrirModalCerdo() {
        document.getElementById("modal-cerdo-titulo").innerText = "Registrar Nuevo Cerdo en Piara";
        document.getElementById("input-cerdo-id").value = "";
        document.getElementById("input-cerdo-crotal").value = "";
        document.getElementById("input-cerdo-rfid").value = "";
        document.getElementById("input-cerdo-sexo").value = "Hembra";
        document.getElementById("input-cerdo-fechanac").value = new Date().toISOString().split("T")[0];
        document.getElementById("input-cerdo-peso").value = "1.5";
        const selGen = document.getElementById("input-cerdo-genetica");
        if (selGen && selGen.options.length > 0) selGen.selectedIndex = 0;
        document.getElementById("input-cerdo-jaula").value = "";
        document.getElementById("input-cerdo-sanitario").value = "Saludable";
        document.getElementById("input-cerdo-obs").value = "";

        recalcularModalEnVivo();
        document.getElementById("modal-cerdo").classList.remove("hidden");
        document.getElementById("modal-cerdo").classList.add("flex");
    }

    function editarCerdo(id) {
        const cerdo = cerdosData.find(c => c.Id.toLowerCase() === id.toLowerCase());
        if (!cerdo) return;

        document.getElementById("modal-cerdo-titulo").innerText = "Editar Datos del Cerdo: " + cerdo.Crotal;
        document.getElementById("input-cerdo-id").value = cerdo.Id;
        document.getElementById("input-cerdo-crotal").value = cerdo.Crotal;
        document.getElementById("input-cerdo-rfid").value = cerdo.Rfid || "";
        document.getElementById("input-cerdo-sexo").value = cerdo.Sexo;
        document.getElementById("input-cerdo-fechanac").value = cerdo.FechaNacimiento.split("T")[0];
        document.getElementById("input-cerdo-peso").value = cerdo.PesoActualKg;
        document.getElementById("input-cerdo-genetica").value = cerdo.LineaGenetica;
        document.getElementById("input-cerdo-jaula").value = cerdo.JaulaCorralId || "";
        document.getElementById("input-cerdo-sanitario").value = cerdo.EstatusSanitario;
        document.getElementById("input-cerdo-obs").value = cerdo.Observaciones || "";

        recalcularModalEnVivo();
        document.getElementById("modal-cerdo").classList.remove("hidden");
        document.getElementById("modal-cerdo").classList.add("flex");
    }

    function asignarCerdoAJaula(jaulaId, jaulaCodigo, etapa) {
        abrirModalCerdo();
        document.getElementById("input-cerdo-jaula").value = jaulaId;
        // Pre-ajustar fecha aproximada según la etapa de la jaula
        const hoy = new Date();
        let diasAtras = 14;
        if (etapa.includes("Precebo")) diasAtras = 40;
        else if (etapa.includes("Crecimiento")) diasAtras = 90;
        else if (etapa.includes("Engorde")) diasAtras = 135;
        else if (etapa.includes("Gestación")) diasAtras = 220;

        const f = new Date(hoy.getTime() - (diasAtras * 24 * 60 * 60 * 1000));
        document.getElementById("input-cerdo-fechanac").value = f.toISOString().split("T")[0];
        recalcularModalEnVivo();
    }

    function cerrarModalCerdo() {
        document.getElementById("modal-cerdo").classList.add("hidden");
        document.getElementById("modal-cerdo").classList.remove("flex");
    }

    function recalcularModalEnVivo() {
        const fechaStr = document.getElementById("input-cerdo-fechanac").value;
        const peso = parseFloat(document.getElementById("input-cerdo-peso").value) || 10;
        if (!fechaStr) return;

        const calc = calcularPlanZootecnicoJS(fechaStr, peso);

        const proxVac = calc.vacunas.find(v => v.dia >= calc.diasVida) || calc.vacunas[calc.vacunas.length - 1];

        const html = `
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-outline">Cálculo Automático por Días de Nacido:</span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-primary text-on-primary">${calc.etapa}</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                <div class="p-2.5 rounded-lg bg-surface-container-lowest border border-outline-variant/60">
                    <span class="text-outline text-10px uppercase font-bold">Edad & Fase:</span>
                    <div class="font-bold text-on-surface text-sm mt-0.5">${calc.diasVida} días de vida</div>
                    <div class="text-10px text-on-surface-variant">${calc.subEtapa} (Ref: ${calc.rangoPeso})</div>
                </div>
                <div class="p-2.5 rounded-lg bg-surface-container-lowest border border-outline-variant/60">
                    <span class="text-outline text-10px uppercase font-bold">Ración Diaria Dividida:</span>
                    <div class="font-bold text-primary text-sm mt-0.5">${calc.racionKg.toFixed(2)} kg/día</div>
                    <div class="text-10px font-semibold text-on-surface">Dividido en <strong class="text-primary">${calc.tomas} tomas</strong> de <strong class="text-primary">${calc.gramosPorToma} g</strong></div>
                </div>
                <div class="p-2.5 rounded-lg bg-surface-container-lowest border border-outline-variant/60">
                    <span class="text-outline text-10px uppercase font-bold">Próxima Vacunación:</span>
                    <div class="font-bold text-on-surface truncate mt-0.5" title="${proxVac.vacuna}">${proxVac.vacuna}</div>
                    <div class="text-10px font-semibold text-rose-700">Día ${proxVac.dia} (${proxVac.estado})</div>
                </div>
            </div>
            <div class="text-10px text-on-surface-variant flex items-center gap-1.5 bg-surface-container-lowest p-2 rounded-lg border border-outline-variant/40">
                <span class="material-symbols-outlined text-14px text-primary">schedule</span>
                <span><strong>Horarios de servicio sugeridos:</strong> ${calc.horarios}</span>
            </div>
        `;

        document.getElementById("modal-preview-calculo").innerHTML = html;
    }

